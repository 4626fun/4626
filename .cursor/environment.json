{
  "$schema": "https://cursor.com/schemas/environment.json",
  "description": "CreatorVault (4626.fun) cloud agent environment",
  "runtime": {
    "node": "22"
  },
  "terminals": [
    {
      "name": "frontend",
      "command": "cd frontend && pnpm dev",
      "description": "Vite dev server (SPA + HMR)",
      "port": 5173
    },
    {
      "name": "cre",
      "command": "cd cre && npm run start",
      "description": "CRE automation workflows (keeper bots)",
      "port": 3000
    }
  ],
  "ports": [5173, 3000],
  "install": ".cursor/install.sh",
  "start": ".cursor/start.sh"
}
