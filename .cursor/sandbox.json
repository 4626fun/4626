{
  "$schema": "https://cursor.com/schemas/sandbox.json",
  "name": "creatorvault-dev",
  "description": "CreatorVault (4626.fun) — Vite frontend + Foundry contracts + CRE keepers",
  "services": {
    "frontend": {
      "command": "cd frontend && pnpm dev",
      "port": 5173,
      "readyPattern": "ready in",
      "healthCheck": "http://localhost:5173/"
    },
    "cre": {
      "command": "cd cre && npm run start",
      "port": 3000,
      "optional": true
    }
  },
  "tools": {
    "forge": {
      "description": "Foundry — Solidity build/test",
      "commands": {
        "build": "forge build",
        "test": "forge test",
        "lint": "forge lint"
      }
    },
    "frontend": {
      "description": "Vite SPA — lint/typecheck/test",
      "commands": {
        "lint": "pnpm -C frontend lint",
        "typecheck": "pnpm -C frontend typecheck",
        "test": "pnpm -C frontend test",
        "build": "pnpm -C frontend build"
      }
    }
  }
}
