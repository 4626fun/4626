# ═══════════════════════════════════════════════════════════════════════════════
#                           4626 Environment
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
#                              REQUIRED
# ═══════════════════════════════════════════════════════════════════════════════

# Your deployer private key (without 0x prefix)
PRIVATE_KEY=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#                         NETWORK CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Base Mainnet RPC (default works, but you can use your own)
RPC_URL=https://mainnet.base.org

# Base Sepolia Testnet (for testing)
# RPC_URL=https://sepolia.base.org

# ═══════════════════════════════════════════════════════════════════════════════
#                     COINBASE DEVELOPER PLATFORM
# ═══════════════════════════════════════════════════════════════════════════════
# Get your API key from: https://portal.cdp.coinbase.com/

# Your Coinbase Paymaster & Bundler endpoint (same URL for both)
# Example: https://api.developer.coinbase.com/rpc/v1/base/<CDP_API_KEY_ID>
BUNDLER_URL=
PAYMASTER_URL=

# ═══════════════════════════════════════════════════════════════════════════════
#                         ERC-4337 SMART ACCOUNT
# ═══════════════════════════════════════════════════════════════════════════════
# Your ERC-4337 compatible smart account address

SMART_ACCOUNT=

# ═══════════════════════════════════════════════════════════════════════════════
#                     DEPLOYED CONTRACT ADDRESSES
# ═══════════════════════════════════════════════════════════════════════════════
# Fill these in after running: ./script/deploy.sh infrastructure

# Core Infrastructure
REGISTRY_4626=
REGISTRY=
REGISTRY_BOOTSTRAP_4626=
OVAULT_FACTORY=
PAYOUT_ROUTER_FACTORY=
DEPLOYMENT_BATCHER=

# Shared Services
LOTTERY_MANAGER=
VRF_CONSUMER=

# Payout router keeper resolution (server-side deploy/paymaster + KPR runtime).
# Priority: PAYOUT_ROUTER_KEEPER -> KPR_KEEPER_ADDRESS -> KPR_ADDRESS -> PROTOCOL_AJNA_KEEPER -> derive KPR_PRIVATE_KEY
# Keeper pins must be the hot KPR EOA, not operator CSW (0xAb6d5…) or protocol CSW (0x793c…).
# Audit I-13 / 4626-394: do not commit real keeper addresses to example env files.
# Use a placeholder here and inject the real address via Vercel/KPR secrets.
PAYOUT_ROUTER_KEEPER=0x0000000000000000000000000000000000000000
KPR_KEEPER_ADDRESS=0x0000000000000000000000000000000000000000
KPR_ADDRESS=0x0000000000000000000000000000000000000000
# Legacy fallback (kept for compatibility during migration):
KPR_KEEPER_ADDRESS=0x0000000000000000000000000000000000000000

# ═══════════════════════════════════════════════════════════════════════════════
#                         CHAINLINK VRF (Optional)
# ═══════════════════════════════════════════════════════════════════════════════
# Create subscription at: https://vrf.chain.link/base

VRF_SUBSCRIPTION_ID=

# ═══════════════════════════════════════════════════════════════════════════════
#                         PRE-DEPLOYED CONTRACTS
# ═══════════════════════════════════════════════════════════════════════════════
# These are already deployed on Base - no need to change

# Tax Hook (6.9% sell fees)
TAX_HOOK=0xca975B9dAF772C71161f3648437c3616E5Be0088

# LayerZero V2 Endpoint
LZ_ENDPOINT=0x1a44076050125825900e736c501f859c50fE728c

# Chainlink ETH/USD Price Feed
CHAINLINK_ETH_USD=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70

# Optional AgentOracle quote-lane wiring (used by script/ConfigureAgentOracle.s.sol)
# Set these when the agent lane uses an AGENT/quote pair and requires explicit quote/USD conversion.
AGENT_ORACLE=
AGENT_TOKEN=
AGENT_ORACLE_PAIR=
AGENT_ORACLE_QUOTE_TOKEN=
AGENT_ORACLE_QUOTE_USD_FEED=
AGENT_ORACLE_TWAP_DURATION=1800
AGENT_ORACLE_LOCK_REFERENCE_QUOTE_TOKEN=0
# Optional post-deploy QA strictness (script/AgentOraclePostDeployQa.s.sol)
AGENT_ORACLE_EXPECT_REFERENCE_QUOTE_LOCKED=0
AGENT_ORACLE_QA_STRICT=0

# Chainlink VRF Coordinator V2.5
VRF_COORDINATOR=0xd5D517aBE5cF79B7e95eC98dB0f0277788aFF634

# ERC-4337 EntryPoint v0.6
ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# ═══════════════════════════════════════════════════════════════════════════════
#                               CREATE2 DEPLOYMENT
# ═══════════════════════════════════════════════════════════════════════════════
#
# Universal CREATE2 deployer (present on Base). Useful if you want a known “CREATE2 factory” address.
CREATE2_FACTORY=0x4e59b44847b379578588920cA78FbF26c0B4956C

# 4626 Phase-2 AA deployer (deployed by this repo; has an explicit ABI: deploy(bytes32,bytes)).
# FIX: M-13 (4626-322) — live value redacted. See
# docs/operations/deployment/addresses.md.
CREATE2_DEPLOYER=0xYOUR_CREATE2_DEPLOYER_HERE

# Optional fresh infra epoch controls (DeployBaseMainnetDeployer):
# Precedence for each salt: raw bytes32 env -> *_SALT_TAG keccak256 -> built-in default.
# Convenience mode: set DEPLOYMENT_EPOCH_TAG and deploy scripts derive all *_SALT_TAG values.
DEPLOYMENT_EPOCH_TAG=
INFRA_STORE_SALT=
INFRA_STORE_SALT_TAG=
INFRA_DEPLOYER_FROM_STORE_SALT=
INFRA_DEPLOYER_FROM_STORE_SALT_TAG=
INFRA_VAULT_CORE_MODULE_SALT=
INFRA_VAULT_CORE_MODULE_SALT_TAG=
INFRA_VAULT_STRATEGIES_MODULE_SALT=
INFRA_VAULT_STRATEGIES_MODULE_SALT_TAG=
INFRA_VAULT_ADMIN_MODULE_SALT=
INFRA_VAULT_ADMIN_MODULE_SALT_TAG=
INFRA_DEPLOYMENT_BATCHER_SALT=
INFRA_DEPLOYMENT_BATCHER_SALT_TAG=

# Current live Base deployment batcher (`DeploymentBatcher`, canonical **v1.14.1** — see docs/reference/addresses.md)
# FIX: M-13 (4626-322) — live values redacted.
DEPLOYMENT_BATCHER=0xYOUR_DEPLOYMENT_BATCHER_HERE
DEPLOYMENT_BATCHER=0xYOUR_DEPLOYMENT_BATCHER_HERE
# Optional alias for env-based cutovers. Current live value matches `DEPLOYMENT_BATCHER`.
# DEPLOYMENT_BATCHER_AUTO_HANDOFF=0xYOUR_AUTO_HANDOFF_HERE

# LayerZero-only Solana ShareOFT routing.
# SOLANA_DESTINATION is the recipient Solana pubkey encoded as bytes32.
# OVAULT_SOLANA_EID is 30168 on Solana mainnet.
SOLANA_DESTINATION=
OVAULT_HUB_COMPOSER=
OVAULT_SOLANA_EID=30168

# Per-creator peer seed inputs. The Solana mint and OFT Store have distinct
# Solana pubkeys; use the creator's OFT Store peer bytes32 here.
# Every creator token requires this explicit Registry4626 entry before finalize.
CREATOR_TOKEN=
SOLANA_EID=30168
SOLANA_REMOTE_OFT_PEER_BYTES32=

# ═══════════════════════════════════════════════════════════════════════════════
#                         ZORA REVENUE / REFERRALS
# ═══════════════════════════════════════════════════════════════════════════════
# Platform referrer address for Zora Coins.
# - Coin creation: earns 0.2% of ALL future trades on that coin FOREVER
# - Per-trade: earns 0.04% per trade executed through Keepr
# Falls back to CANONICAL_CSW_ADDRESS if not set.
ZORA_PLATFORM_REFERRER_ADDRESS=
# Client-side (Vite VITE_ prefix) — used by the waitlist coin creation card
VITE_ZORA_PLATFORM_REFERRER_ADDRESS=

# Auto-cast trade events to Farcaster (true/false, default: false)
AUTOCAST_TRADES=false

# Neynar webhook secret for Farcaster mention replies
FC_MENTION_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
#                         4626 INFRASTRUCTURE (Base Mainnet)
# ═══════════════════════════════════════════════════════════════════════════════
# Shared resources (registry/lottery/VRF/payout factory/vault activation batcher)
# carry over from the v1.8.3 broadcast (2026-04-11). Module + bytecode store +
# DeploymentBatcher were re-deployed in the v1.9.1 broadcast (2026-04-19) to
# enable the weight-0-skip + at-least-1-strategy behavior for the paid opt-in
# feature paywall. Historical v1.8.3 addresses for these are preserved in
# AGENTS.md + docs/operations/creator-strategy-features.md for audit.

# FIX: M-13 (4626-322) — live protocol addresses redacted from the
# committed example. Canonicalised in docs/operations/deployment/addresses.md
# and should be pulled from there (or from a CI-injected secret) at
# runtime — never committed.
REGISTRY_4626=0xYOUR_REGISTRY_4626_HERE
REGISTRY=0xYOUR_REGISTRY_HERE
OVAULT_FACTORY=0xYOUR_OVAULT_FACTORY_HERE
LOTTERY_MANAGER=0xYOUR_LOTTERY_MANAGER_HERE
VRF_CONSUMER=0xYOUR_VRF_CONSUMER_HERE
PAYOUT_ROUTER_FACTORY=0xYOUR_PAYOUT_ROUTER_FACTORY_HERE
VAULT_ACTIVATION_BATCHER=0xYOUR_VAULT_ACTIVATION_BATCHER_HERE

# v1.14.1 chunked store + deployer + batcher (2026-06). Previous epochs preserved under
# docs/_internal/deployment-releases-legacy/ and docs/reference/addresses.md (retired rows).
# FIX: M-13 (4626-322) — live batcher/store addresses redacted. See docs/reference/addresses.md.
UNIVERSAL_BYTECODE_STORE=0xYOUR_UNIVERSAL_BYTECODE_STORE_HERE
# Must pair with UNIVERSAL_BYTECODE_STORE (live v1.14.1: chunked store 0xb371… → deployer 0x2fA570…).
UNIVERSAL_CREATE2_FROM_STORE=0xYOUR_UNIVERSAL_CREATE2_FROM_STORE_HERE
DEPLOYMENT_BATCHER=0xYOUR_DEPLOYMENT_BATCHER_HERE
DEPLOYMENT_BATCHER=0xYOUR_DEPLOYMENT_BATCHER_HERE
# Optional alias for env-based cutovers. Current live value matches `DEPLOYMENT_BATCHER`.
# DEPLOYMENT_BATCHER_AUTO_HANDOFF=0xYOUR_AUTO_HANDOFF_HERE
# Phase-2 auxiliary CREATE2 helper (server/paymaster). Pair with VITE_VAULT_AUXILIARY_DEPLOY_BATCHER.
# See docs/_internal/operations/deployment/deploy-capable-batcher-rotation.md
VAULT_AUXILIARY_DEPLOY_BATCHER=0xYOUR_VAULT_AUXILIARY_DEPLOY_BATCHER_HERE

# ═══════════════════════════════════════════════════════════════════════════════
#                     CREATOR STRATEGY FEATURES — PAYMENT PATHS
# ═══════════════════════════════════════════════════════════════════════════════
# docs/operations/creator-strategy-features.md § "Payment paths"

# USDC destination for all creator strategy feature payments (USDC-on-Base
# and x402). Defaults to the protocol treasury Safe when unset — only override
# this for staging environments that must route payments to a different sink.
# CREATOR_STRATEGY_FEATURE_USDC_TREASURY=0xYOUR_TREASURY_SAFE_HERE

# ----- x402 (HTTP 402 Payment Required, EIP-3009 gasless USDC) -----
# Private key (with or without 0x prefix) of the EOA that broadcasts the
# settled `usdc.transferWithAuthorization(...)` tx on Base. The relayer pays
# Base gas so the creator doesn't need ETH. Fall-through order:
#   1. X402_RELAYER_PRIVATE_KEY (preferred, isolated from infra key)
#   2. PRIVATE_KEY (top of this file; fallback)
# If neither is set, the /api/creator/strategy/x402-activate endpoint still
# returns a valid 402 response but rejects settlement with
# `x402_relayer_not_configured` when a signed authorization arrives.
# X402_RELAYER_PRIVATE_KEY=

# ----- Stripe (credit-card fiat payments) -----
# Get from https://dashboard.stripe.com/apikeys (use TEST keys for dev/staging).
# When unset, /api/creator/strategy/stripe/checkout returns 503 and the
# payment path is effectively disabled.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Base origin for the Stripe Checkout return URLs. The handler appends
# /creator/strategy/activation-success?... and /activation-cancelled?...
# to this. Defaults to http://localhost:5173 for local dev.
# STRIPE_RETURN_URL_BASE=https://app.4626.fun

# ═══════════════════════════════════════════════════════════════════════════════
#            ALFACLUB OFFICIAL SUDOSWAP + UNIVERSAL ROUTER (Base)
# ═══════════════════════════════════════════════════════════════════════════════
# Official Sudoswap v2 dependencies on Base (chain 8453).
SUDOSWAP_PAIR_FACTORY=0x605145D263482684590f630E9e581B21E4938eb8
SUDOSWAP_XYK_CURVE=0xd0A2f4ae5E816ec09374c67F6532063B60dE037B
# AlfaClub-owned Base deployments (verified after broadcast).
ALFACLUB_UNIVERSAL_ROUTER=0x14c0e8840A3B7caE49EbdA899C7101A827598e9f
ALFACLUB_SUDOSWAP_ADAPTER=0x961b113FF5E3547e8198758900b8f4Fa552A3Fe5
ALFACLUB_ROOM_1659_SUDOSWAP_PAIR=0x4a1bD15948A6a61DbE5dfD1e57d5982fD1285766
ALFACLUB_MARKET_ADMIN_SAFE=0x7d429eCbdcE5ff516D6e0a93299cbBa97203f2d3

# Router deployment: exact current EOA nonce is required so both circular
# immutable addresses can be predicted. Omitting --broadcast is simulation only.
EXPECTED_DEPLOYER_NONCE=
# Pair deployment: the pair is the LP position; transfer ownership to the Safe.
# Room 1659 assets are held by CANONICAL_CSW_ADDRESS, so production uses
# `pnpm -C frontend ops:alfaclub-sudoswap-seed-csw --dry-run` and then an
# explicitly reviewed `--apply`. PRIVATE_KEY is only for the EOA rehearsal path.
PAIR_OWNER=0x7d429eCbdcE5ff516D6e0a93299cbBa97203f2d3
INITIAL_KEY_BALANCE=
INITIAL_CREATOR_COIN_BALANCE=
VIRTUAL_KEY_RESERVE=
VIRTUAL_CREATOR_COIN_RESERVE=
# Room 1659 is a Trading room: 0.069e18 = 690 bps = 6.9%.
PAIR_FEE=69000000000000000
# Approval-clean live buy/sell proof. The ops script refuses values above 500.
ALFACLUB_SUDOSWAP_CANARY_SLIPPAGE_BPS=100
