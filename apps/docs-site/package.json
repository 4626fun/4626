{
  "name": "4626-docs-site",
  "version": "1.8.1",
  "private": true,
  "scripts": {
    "generate:contracts": "cd ../.. && ([ \"$DOCS_SKIP_FORGE\" = \"1\" ] && echo 'Skipping forge doc (DOCS_SKIP_FORGE=1)' || (command -v forge >/dev/null && forge doc || echo 'Skipping forge doc (not installed)'))",
    "generate:frontend": "cd ../../frontend && ([ \"$DOCS_SKIP_TYPEDOC\" = \"1\" ] && echo 'Skipping typedoc (DOCS_SKIP_TYPEDOC=1)' || ([ -d node_modules/typedoc ] && pnpm exec typedoc || echo 'Skipping typedoc (dependencies not installed)'))",
    "generate:all": "pnpm generate:contracts; pnpm generate:frontend; true",
    "sync-docs": "node scripts/sync-docs.mjs",
    "sync-docs:strict": "node scripts/sync-docs.mjs --strict",
    "check:hygiene-policy": "node scripts/check-docs-hygiene-policy.mjs",
    "check-links": "node scripts/check-doc-links.mjs",
    "api:postprocess": "tsx scripts/postprocess-api-docs.ts",
    "api:postprocess:strict": "tsx scripts/postprocess-api-docs.ts --strict",
    "docusaurus": "docusaurus",
    "prepare:content": "pnpm generate:all && pnpm sync-docs && pnpm api:postprocess",
    "start": "pnpm api:postprocess && docusaurus start",
    "build": "pnpm api:postprocess && docusaurus build",
    "build:full": "pnpm prepare:content && docusaurus build",
    "build:slim": "DOCS_SKIP_FORGE=1 DOCS_SKIP_TYPEDOC=1 pnpm run build",
    "build:quick": "pnpm sync-docs && pnpm api:postprocess && docusaurus build",
    "build:strict": "pnpm sync-docs:strict && pnpm api:postprocess:strict && docusaurus build",
    "bundle:strict": "pnpm sync-docs:strict && pnpm api:postprocess:strict && docusaurus build --no-minify",
    "qmd:setup": "node scripts/qmd-setup.mjs",
    "qmd:embed": "qmd embed",
    "qmd:query": "qmd query",
    "qmd:status": "qmd status",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/plugin-client-redirects": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@docusaurus/theme-mermaid": "^3.9.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@types/node": "^25.2.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "20.x"
  },
  "pnpm": {
    "overrides": {
      "ajv@^6.0.0": "6.14.0",
      "ajv@^8.0.0": "8.18.0",
      "brace-expansion": "5.0.5",
      "dompurify": "3.4.0",
      "express>path-to-regexp": "0.1.13",
      "follow-redirects": "1.16.0",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "minimatch": "10.2.3",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "qs": "6.14.2",
      "serialize-javascript": "7.0.5",
      "svgo": "3.3.3"
    }
  }
}
