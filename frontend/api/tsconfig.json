{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@4626/server-core": ["../packages/server-core/src/index.ts"],
      "@4626/server-core/*": ["../packages/server-core/src/*"]
    }
  },
  // Only typecheck our local API proxy handlers used by the Vite dev server.
  // Avoid pulling in unrelated serverless files that depend on backend-only deps.
  "include": [
    "./_handlers/**/*.ts",
    "./_lib/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
