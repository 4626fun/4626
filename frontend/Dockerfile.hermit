# --------------------------------------------------------------------------
# 4626 Hermit Agent — Dedicated Production Dockerfile
# --------------------------------------------------------------------------
# This is the dedicated Railway image for Hermit AlfaClub room ingest,
# command replies, and the single InverseAKITA executor. Creative inference
# stays on Vercel behind /api/hermit/draft.
#
# It is intentionally separate from the general agent image (Dockerfile.agent)
# to avoid complex entrypoint logic that has been causing repeated healthcheck
# failures on Railway.
#
# Key features:
# - Starts the health listener in bootstrap.ts as early as possible.
# - Uses the same dependency and source layout as the main agent image.
#
# Build (from repo root):
#   docker build -f frontend/Dockerfile.hermit -t 4626-hermit .
#
# Railway service configuration:
#   - Root Directory: (leave as repo root or frontend if you prefer)
#   - Dockerfile Path: frontend/Dockerfile.hermit
#   - Environment Variables: AGENT_PROCESS=hermit (optional, not used in this image)
#   - Recommended Start Command override (if you want to be extra safe):
#       bash -lc 'exec gosu node npx tsx server/agents/hermit/bootstrap.ts'
#
# Healthcheck: /healthz (served by bootstrap.ts immediately on startup)
# --------------------------------------------------------------------------

FROM node:22-bookworm-slim AS base

# Install OS deps for native modules (sharp, etc.) + gosu for dropping privileges
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates gosu git jq \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate

WORKDIR /app

# --------------------------------------------------------------------------
# Stage 1: Install dependencies
# --------------------------------------------------------------------------
FROM base AS deps

# Copy package manifests + patch files
COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/patches/ ./patches/

# Include @4626/server-core (required by command families and server/_lib)
COPY frontend/packages/server-core/package.json ./packages/server-core/package.json
COPY frontend/packages/server-core/tsconfig.json ./packages/server-core/tsconfig.json
COPY frontend/packages/server-core/build.mjs ./packages/server-core/build.mjs
COPY frontend/packages/server-core/src ./packages/server-core/src

# server-core build.mjs re-exports compile server/_lib/*.ts siblings; those
# sources (and their src/ imports) must exist before the deps-stage build.
COPY frontend/server ./server
COPY frontend/api/_handlers/token ./api/_handlers/token
COPY frontend/src/config ./src/config
COPY frontend/src/lib ./src/lib
COPY frontend/src/wallet ./src/wallet

# Install dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm rebuild

# Build @4626/server-core so that dist/ is generated.
# The package is imported by command families (e.g. alfaclub.ts) and many
# server/_lib modules. tsx resolves the package.json "main" field to dist/.
RUN cd packages/server-core && node build.mjs

# --------------------------------------------------------------------------
# Stage 2: Production image
# --------------------------------------------------------------------------
FROM base AS runner

WORKDIR /app

ARG DGCLAW_SKILL_REPO=https://github.com/Virtual-Protocol/dgclaw-skill.git
# Pin to tested commit SHAs (not floating main). Upgrade path: bump these SHAs
# after a known-good local Arena trade smoke, then rebuild Dockerfile.hermit.
ARG DGCLAW_SKILL_REF=2a8b79728c17c428421f30f5ed545ab5ff4f335c
ARG ACP_CLI_REPO=https://github.com/Virtual-Protocol/acp-cli.git
ARG ACP_CLI_REF=24e5affdd71980fd32fff177a7dac3a850c2555c
# 1.0.26 fixes SSE wallet auth context (`agentAddresses.evm` + signMessage).
# 1.0.25 crashes sign-typed-data with: Cannot read properties of undefined (reading 'evm').
ARG ACP_CLI_NPM_VERSION=1.0.26
ARG VIEM_VERSION=2.45.1

# Copy installed node_modules and package.json
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy the server-core workspace package
COPY --from=deps /app/packages/server-core ./packages/server-core

# server tree includes build.mjs runtime siblings (e.g. renderPremiumTokenIcon.js)
COPY --from=deps /app/server ./server
COPY frontend/api ./api
COPY frontend/src/config ./src/config
COPY frontend/src/lib ./src/lib
COPY frontend/src/wallet ./src/wallet
COPY frontend/tsconfig.json frontend/tsconfig.node.json ./
COPY frontend/shared ./shared

# Arena runtime prerequisites:
# - ACP CLI binary (`acp`) on PATH
# - dgclaw-skill workspace containing `dgclaw.sh` + scripts/*
# - local acp-cli checkout at ACP_CLI_DIR (dgclaw join)
#
# Install order matters: global @virtuals-protocol/acp-cli supplies the runtime
# `acp` binary (trade.ts prefers ACP_BIN / PATH). The git checkout is kept for
# ACP_CLI_DIR compatibility only — do not npm install inside it (tsx/esbuild
# postinstall fails reliably in this image).
RUN git init /app/dgclaw-skill \
  && cd /app/dgclaw-skill \
  && git remote add origin "${DGCLAW_SKILL_REPO}" \
  && git fetch --depth=1 origin "${DGCLAW_SKILL_REF}" \
  && git checkout --detach FETCH_HEAD \
  && npm install --omit=dev \
  # viem powers the optional HL_AGENT_PRIVATE_KEY signing lane in the patched
  # trade.ts (user-silo liquidation defense signs with an approved HL API
  # wallet key instead of acp-cli). Upstream dgclaw does not depend on it.
  && npm install --no-save --omit=dev "viem@${VIEM_VERSION}"

RUN git init /app/acp-cli \
  && cd /app/acp-cli \
  && git remote add origin "${ACP_CLI_REPO}" \
  && git fetch --depth=1 origin "${ACP_CLI_REF}" \
  && git checkout --detach FETCH_HEAD

RUN npm install -g "@virtuals-protocol/acp-cli@${ACP_CLI_NPM_VERSION}"

# Overlay repo-patched dgclaw scripts on top of the upstream clone.
# trade.ts adds: partial close (`close --size <usd>`, reduce-only) for the
# counter-trade / inverse chat / liquidation-defense loop; optional Cabals HL
# builder attachment (`ARENA_CABALS_BUILDER_ENABLED`) so Arena fills can count
# on Cabals. Sourced from patches/ (repo-native) rather than the dgclaw-skill
# submodule so the Railway build context does not depend on submodule checkout.
COPY patches/dgclaw/trade.ts /app/dgclaw-skill/scripts/trade.ts
COPY frontend/docker/hermit-entrypoint.sh /usr/local/bin/hermit-entrypoint.sh
RUN chmod +x /usr/local/bin/hermit-entrypoint.sh \
  && chown -R node:node /app

# Health check port
ENV PORT=8080
ENV ACP_CLI_DIR=/app/acp-cli
ENV ACP_BIN=acp
ENV ARENA_ACP_HOME=/data/acp-home
EXPOSE 8080
# Stay root for entrypoint so mounted ACP home can be chown'd, then drop via gosu.
USER root

# The absolute simplest possible startup for maximum reliability on Railway.
# We use the local tsx binary directly (no npx) and exec so the process is PID 1.
# bootstrap.ts starts the /healthz listener *before* any heavy module imports.
ENTRYPOINT ["/usr/local/bin/hermit-entrypoint.sh"]
CMD ["./node_modules/.bin/tsx", "server/agents/hermit/bootstrap.ts"]
