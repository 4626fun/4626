{
  "name": "4626-app",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "scripts": {
    "generate:html-shells": "node scripts/generate-html-shells.mjs",
    "check:html-shells": "node scripts/generate-html-shells.mjs --check",
    "predev": "pnpm generate:html-shells",
    "prebuild:app": "pnpm generate:html-shells",
    "prebuild:telegram-link-standalone": "pnpm generate:html-shells",
    "prebuild:highmem:app": "pnpm generate:html-shells",
    "prebuild:highmem:telegram-link-standalone": "pnpm generate:html-shells",
    "dev": "vite --config vite.config.ts",
    "clean:dist": "node scripts/clean-dist.mjs",
    "build:clean": "pnpm clean:dist && pnpm build",
    "build": "pnpm build:app && pnpm build:telegram-link-standalone",
    "build:app": "vite build --config vite.config.ts",
    "build:telegram-link-standalone": "TELEGRAM_LINK_STANDALONE_BUILD=1 vite build --config vite.config.ts --emptyOutDir=false",
    "build:highmem": "pnpm build:highmem:app && pnpm build:highmem:telegram-link-standalone",
    "build:highmem:app": "NODE_OPTIONS=--max-old-space-size=4096 vite build --config vite.config.ts",
    "build:highmem:telegram-link-standalone": "NODE_OPTIONS=--max-old-space-size=4096 TELEGRAM_LINK_STANDALONE_BUILD=1 vite build --config vite.config.ts --emptyOutDir=false",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --config vite.config.ts",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs --out public",
    "generate:social-preview": "node scripts/generate-social-preview.mjs",
    "report:footprint": "node scripts/report-footprint.mjs",
    "guard:generated-output": "node scripts/check-generated-output.mjs",
    "guard:runtime-boundaries": "node scripts/check-runtime-boundaries.mjs",
    "capture:app-screens": "node scripts/capture-app-screenshots.mjs",
    "docs": "pnpm exec typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:waitlist-handoff": "node scripts/e2e-waitlist-handoff-regression.mjs",
    "test:e2e:deploy-session-resume": "node scripts/e2e-deploy-session-resume-regression.mjs",
    "dev:deploy-dry-run": "bash scripts/dev-deploy-dry-run.sh",
    "smoke:deploy-dry-run": "bash scripts/smoke-deploy-dry-run.sh",
    "uniswap:openapi": "openapi-typescript https://trade-api.gateway.uniswap.org/v1/api.json --output src/lib/uniswap/generated/tradeApi.ts",
    "agent:start": "pnpm agent:eliza",
    "agent:eliza": "tsx --env-file=.env --env-file=../cre/.env server/agent/eliza/index.ts",
    "agent:eliza:doctor": "tsx --env-file=.env --env-file=../cre/.env scripts/agent/eliza-doctor.ts",
    "agent:eliza:standby:smoke": "bash -lc 'tmp_xmtp_db_dir=$(mktemp -d); trap \"rm -rf \\\"$tmp_xmtp_db_dir\\\"\" EXIT; timeout 20s env PORT=${PORT:-8081} AGENT_RUNTIME_ROLE=standby AGENT_CONSUME_XMTP=false XMTP_DB_DIRECTORY=\"$tmp_xmtp_db_dir\" pnpm agent:eliza; code=$?; if [ \"$code\" -eq 124 ]; then exit 0; fi; exit \"$code\"'",
    "solana-provisioner:start": "if [ -f server/solana-provisioner/.env ]; then tsx --env-file=server/solana-provisioner/.env server/solana-provisioner/index.ts; else tsx server/solana-provisioner/index.ts; fi",
    "solana-mint:mine": "tsx scripts/mine-solana-mint-vanity.ts",
    "csw:link-owner": "tsx scripts/link-canonical-csw-owner.ts",
    "csw:owner-link:backfill": "tsx scripts/csw-owner-link-backfill.ts",
    "ajna:admin:backfill:safe": "tsx scripts/ops/ajna-admin-backfill-safe.ts",
    "batcher:solana:config:safe": "tsx scripts/ops/propose-batcher-solana-config-safe.ts",
    "privy:user:migrate": "tsx scripts/migrate-privy-user.ts",
    "db:migrate": "pnpm -C .. dlx supabase@latest migration up --linked",
    "check:agent-registration": "node scripts/check-agent-registration.mjs",
    "verify:protocol-assets": "node scripts/verify-protocol-assets.mjs",
    "guard:api-server-shims": "node scripts/check-no-api-server-shims.mjs",
    "guard:server-core-boundary": "node scripts/check-server-core-boundary.mjs",
    "builder-codes:verify": "if [ -f .env ]; then tsx --env-file=.env scripts/verify-builder-codes.ts; else tsx scripts/verify-builder-codes.ts; fi",
    "builder-codes:assert-env": "tsx scripts/assert-builder-codes-env.ts",
    "deploy:autopilot": "node scripts/deploy-autopilot.mjs",
    "synthesis:check": "node scripts/check-synthesis-submission-ready.mjs",
    "synthesis:artifacts": "node scripts/generate-synthesis-artifacts.mjs",
    "synthesis:bundle": "node scripts/build-synthesis-submission.mjs",
    "skills:sync:cursor": "node scripts/sync-cursor-skills.mjs --prune"
  },
  "dependencies": {
    "@4626/brand-kit": "workspace:*",
    "@buildersgarden/siwa": "^0.0.11",
    "@coinbase/wallet-sdk": "4.3.7",
    "@google/model-viewer": "3.5.0",
    "@lens-chain/storage-client": "^1.0.6",
    "@lens-protocol/client": "0.0.0-canary-20250430134539",
    "@privy-io/react-auth": "^3.13.1",
    "@privy-io/server-auth": "^1.32.5",
    "@privy-io/wagmi": "^4.0.1",
    "@safe-global/api-kit": "^4.0.1",
    "@safe-global/protocol-kit": "^6.1.2",
    "@safe-global/types-kit": "^3.0.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.95.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/pg": "^8.16.0",
    "@vercel/blob": "^2.1.0",
    "@vercel/postgres": "^0.10.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@wagmi/core": "^2.22.1",
    "@web3icons/react": "^4.1.17",
    "@xmtp/agent-sdk": "^2.0.2",
    "@xmtp/browser-sdk": "^6.3.0",
    "@xmtp/content-type-primitives": "^3.0.1",
    "@zoralabs/coins-sdk": "0.4.7",
    "@zoralabs/protocol-deployments": "^0.7.2",
    "buffer": "^6.0.3",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "ox": "^0.11.3",
    "permissionless": "^0.3.4",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "usehooks-ts": "^3.1.1",
    "viem": "^2.45.1",
    "vite": "^7.3.1",
    "wagmi": "^2.19.5",
    "x402": "0.7.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vercel/node": "^5.5.30",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.58.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@reown/appkit",
      "bufferutil",
      "esbuild",
      "sharp",
      "utf-8-validate"
    ],
    "overrides": {
      "@coinbase/wallet-sdk": "4.3.7",
      "cbw-sdk": "npm:@coinbase/wallet-sdk@4.3.7",
      "defu": "6.1.6",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "axios": "1.13.5",
      "ajv@^6.0.0": "6.14.0",
      "ajv@^8.0.0": "8.18.0",
      "bn.js": "5.2.3",
      "flatted": "3.4.2",
      "h3": "1.15.9",
      "hono": "4.12.7",
      "markdown-it": "14.1.1",
      "minimatch": "10.2.3",
      "node-fetch": "2.7.0",
      "path-to-regexp": "8.4.0",
      "qs": "6.14.2",
      "socket.io-parser": "4.2.6",
      "tar": "7.5.11",
      "undici": "6.24.0",
      "handlebars": "4.7.9",
      "yaml": "2.8.3",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "brace-expansion": "5.0.5",
      "elliptic": "6.6.1",
      "serialize-javascript": "7.0.5"
    },
    "patchedDependencies": {
      "elliptic@6.6.1": "patches/elliptic@6.6.1.patch"
    }
  }
}
