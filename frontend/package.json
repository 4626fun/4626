{
  "name": "4626-web",
  "description": "ERC-4626 creator vaults on Base",
  "homepage": "https://4626.fun",
  "private": true,
  "version": "1.12.0",
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "type": "module",
  "scripts": {
    "generate:html-shells": "node scripts/generate-html-shells.mjs",
    "sync:canvas-tokens": "node scripts/sync-canvas-tokens.mjs",
    "check:canvas-tokens": "node scripts/sync-canvas-tokens.mjs --check",
    "check:html-shells": "node scripts/generate-html-shells.mjs --check",
    "predev": "pnpm generate:html-shells",
    "prebuild:app": "pnpm generate:html-shells",
    "prebuild:telegram-link-standalone": "pnpm generate:html-shells",
    "dev": "vite --config vite.config.ts",
    "dev:low-memory": "VITE_LOW_MEMORY=1 vite --config vite.config.ts",
    "clean:dist": "node scripts/clean-dist.mjs",
    "clean:derived-assets": "node scripts/clean-derived-assets.mjs",
    "build:clean": "pnpm clean:dist && pnpm build",
    "build:server-core": "node packages/server-core/build.mjs",
    "build": "pnpm build:server-core && pnpm build:app && pnpm build:telegram-link-standalone && pnpm build:marketing-vault",
    "build:marketing-vault": "node scripts/sync-immersive-three-vendor.mjs && NODE_OPTIONS=--max-old-space-size=4096 vite build --config vite.marketing-vault.config.ts && node scripts/copy-marketing-vault-bundle.mjs",
    "build:vault-glb": "blender --background --python ../tools/vault-images/ethereum_vault_generator.py",
    "build:app": "NODE_OPTIONS=--max-old-space-size=7168 vite build --config vite.config.ts",
    "build:telegram-link-standalone": "NODE_OPTIONS=--max-old-space-size=7168 TELEGRAM_LINK_STANDALONE_BUILD=1 vite build --config vite.config.ts --emptyOutDir=false",
    "build:highmem": "pnpm generate:html-shells && pnpm clean:dist && pnpm build:server-core && bash -c 'NODE_OPTIONS=--max-old-space-size=3584 vite build --config vite.config.ts --emptyOutDir=false & APP_PID=$!; NODE_OPTIONS=--max-old-space-size=3584 TELEGRAM_LINK_STANDALONE_BUILD=1 vite build --config vite.config.ts --emptyOutDir=false & TG_PID=$!; wait $APP_PID && wait $TG_PID'",
    "build:highmem:app": "NODE_OPTIONS=--max-old-space-size=7168 vite build --config vite.config.ts",
    "build:highmem:telegram-link-standalone": "NODE_OPTIONS=--max-old-space-size=7168 TELEGRAM_LINK_STANDALONE_BUILD=1 vite build --config vite.config.ts --emptyOutDir=false",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "lint:a11y": "eslint -c eslint.a11y.config.js . --ext ts,tsx",
    "smoke:a11y": "tsx scripts/a11y-smoke.ts",
    "smoke:xmtp-canary": "tsx scripts/xmtp-connect-canary.ts",
    "test:xmtp-connect": "vitest run src/lib/xmtp/xmtpConnectFlow.test.ts src/lib/xmtp/xmtpConnectOrchestrator.test.ts src/lib/xmtp/xmtpConnectHardening.test.ts src/lib/xmtp/xmtpConnectPolicy.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --config vite.config.ts",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs --out public && node scripts/sync-static-favicon-head.mjs",
    "generate:social-preview": "node scripts/generate-social-preview.mjs",
    "generate:brand-assets:static": "pnpm generate:social-preview && pnpm generate:brand-icons",
    "report:footprint": "node scripts/report-footprint.mjs",
    "guard:generated-output": "node scripts/check-generated-output.mjs",
    "guard:runtime-boundaries": "node scripts/check-runtime-boundaries.mjs",
    "guard:arch-b-subaccount-alignment": "node scripts/check-arch-b-subaccount-alignment.mjs",
    "guard:test-file-placement": "node scripts/check-test-file-placement.mjs",
    "guard:api-readjsonbody-maxbytes": "node scripts/check-readjsonbody-maxbytes.mjs",
    "guard:api-rate-limit-guards": "node scripts/check-guard-rate-limit.mjs",
    "guard:api-429-retry-after": "node scripts/check-api-429-retry-after.mjs",
    "guard:explore-no-aliases": "node scripts/check-explore-no-aliases.mjs",
    "guard:api-nonv1-hardening": "node scripts/check-nonv1-hardening.mjs",
    "guard:typedoc-breadth": "node scripts/check-typedoc-breadth.mjs",
    "guard:typedoc-warnings": "node scripts/check-typedoc-warnings.mjs",
    "guard:sc-hygiene": "node scripts/check-sc-hygiene.mjs",
    "capture:app-screens": "node scripts/capture-app-screenshots.mjs",
    "docs": "pnpm guard:typedoc-breadth && pnpm guard:typedoc-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:waitlist-handoff": "node scripts/e2e-waitlist-handoff-regression.mjs",
    "test:e2e:waitlist-swap-bounce": "node scripts/e2e-waitlist-swap-bounce-regression.mjs",
    "test:e2e:deploy-session-resume": "node scripts/e2e-deploy-session-resume-regression.mjs",
    "dev:deploy-dry-run": "bash scripts/dev-deploy-dry-run.sh",
    "smoke:deploy-dry-run": "bash scripts/smoke-deploy-dry-run.sh",
    "uniswap:openapi": "openapi-typescript https://trade-api.gateway.uniswap.org/v1/api.json --output src/lib/uniswap/generated/tradeApi.ts",
    "agent:start": "pnpm agent:eliza",
    "agent:eliza": "tsx --env-file=.env server/agents/eliza/index.ts",
    "agent:eliza:doctor": "tsx --env-file=.env scripts/agent/eliza-doctor.ts",
    "agent:eliza:standby:smoke": "bash -lc 'tmp_xmtp_db_dir=$(mktemp -d); trap \"rm -rf \\\"$tmp_xmtp_db_dir\\\"\" EXIT; timeout 20s env PORT=${PORT:-8081} AGENT_RUNTIME_ROLE=standby AGENT_CONSUME_XMTP=false XMTP_DB_DIRECTORY=\"$tmp_xmtp_db_dir\" pnpm agent:eliza; code=$?; if [ \"$code\" -eq 124 ]; then exit 0; fi; exit \"$code\"'",
    "keeper:jobs:worker": "tsx --env-file=.env scripts/keeper-job-worker.ts",
    "ops:1659-risk-watcher": "tsx ../scripts/ops/1659-risk-watcher.ts",
    "ops:1659-risk-watcher:test": "tsx ../scripts/ops/1659-risk-watcher.ts --test-alert",
    "ops:1659-enqueue-recurring": "tsx ../scripts/ops/1659-risk-watcher/enqueue-recurring.ts",
    "agent:railway-keepr-doctor": "tsx ../scripts/agent/railway-keepr-primary-doctor.ts",
    "control-plane:stuck-scan": "tsx --env-file=.env scripts/control-plane-stuck-operations.ts",
    "alfaclub:chat:smoke": "tsx --env-file=.env scripts/alfaclub-chat-smoke.ts",
