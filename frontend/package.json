{
  "name": "4626-miniapp",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-brand-icons.mjs --out dist",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs --out dist",
    "capture:miniapp-screens": "node scripts/capture-miniapp-screenshots.mjs",
    "docs": "pnpm exec typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "uniswap:openapi": "openapi-typescript https://trade-api.gateway.uniswap.org/v1/api.json --output src/lib/uniswap/generated/tradeApi.ts",
    "agent:start": "pnpm agent:eliza",
    "agent:eliza": "tsx --env-file=.env --env-file=../cre/.env server/agent/eliza/index.ts",
    "solana-provisioner:start": "if [ -f server/solana-provisioner/.env ]; then tsx --env-file=server/solana-provisioner/.env server/solana-provisioner/index.ts; else tsx server/solana-provisioner/index.ts; fi",
    "solana-mint:mine": "tsx scripts/mine-solana-mint-vanity.ts",
    "csw:link-owner": "tsx scripts/link-canonical-csw-owner.ts",
    "csw:owner-link:backfill": "tsx scripts/csw-owner-link-backfill.ts",
    "privy:user:migrate": "tsx scripts/migrate-privy-user.ts",
    "check:agent-registration": "node scripts/check-agent-registration.mjs",
    "verify:protocol-assets": "node scripts/verify-protocol-assets.mjs",
    "builder-codes:verify": "if [ -f .env ]; then tsx --env-file=.env scripts/verify-builder-codes.ts; else tsx scripts/verify-builder-codes.ts; fi",
    "builder-codes:assert-env": "tsx scripts/assert-builder-codes-env.ts",
    "deploy:autopilot": "node scripts/deploy-autopilot.mjs",
    "skills:sync:cursor": "node scripts/sync-cursor-skills.mjs --prune"
  },
  "dependencies": {
    "@4626/brand-kit": "workspace:*",
    "@buildersgarden/siwa": "^0.0.11",
    "@coinbase/cdp-sdk": "^1.44.0",
    "@coinbase/onchainkit": "^1.1.2",
    "@coinbase/wallet-sdk": "4.3.7",
    "@farcaster/auth-client": "^0.7.1",
    "@farcaster/auth-kit": "^0.8.2",
    "@farcaster/miniapp-node": "^0.1.13",
    "@farcaster/miniapp-sdk": "^0.2.3",
    "@farcaster/miniapp-wagmi-connector": "^1.1.1",
    "@farcaster/quick-auth": "^0.0.8",
    "@lens-chain/storage-client": "^1.0.6",
    "@lens-protocol/client": "0.0.0-canary-20250430134539",
    "@privy-io/cross-app-connect": "^0.5.2",
    "@privy-io/react-auth": "^3.13.1",
    "@privy-io/server-auth": "^1.32.5",
    "@privy-io/wagmi": "^4.0.1",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.95.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/d3": "^7.4.3",
    "@types/pg": "^8.16.0",
    "@vercel/blob": "^2.1.0",
    "@vercel/postgres": "^0.10.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@wagmi/core": "^2.22.1",
    "@web3icons/react": "^4.1.17",
    "@xmtp/agent-sdk": "^2.0.2",
    "@xmtp/browser-sdk": "^6.3.0",
    "@xmtp/content-type-primitives": "^3.0.1",
    "@zoralabs/coins-sdk": "0.4.3",
    "@zoralabs/protocol-deployments": "^0.7.2",
    "buffer": "^6.0.3",
    "d3": "^7.9.0",
    "ethereum-identity-kit": "^0.2.72",
    "ethers": "^6.16.0",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "ox": "^0.11.3",
    "permissionless": "^0.3.4",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "usehooks-ts": "^3.1.1",
    "viem": "^2.45.1",
    "vite": "^7.3.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vercel/node": "^5.5.30",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.58.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@reown/appkit",
      "bufferutil",
      "esbuild",
      "sharp",
      "utf-8-validate"
    ],
    "overrides": {
      "@coinbase/wallet-sdk": "4.3.7",
      "cbw-sdk": "npm:@coinbase/wallet-sdk@4.3.7",
      "axios": "1.13.5",
      "ajv@^6.0.0": "6.14.0",
      "ajv@^8.0.0": "8.18.0",
      "bn.js": "5.2.3",
      "hono": "4.11.10",
      "markdown-it": "14.1.1",
      "minimatch": "10.2.3",
      "node-fetch": "2.7.0",
      "path-to-regexp": ">=8.0.0",
      "qs": "6.14.2",
      "tar": "7.5.8",
      "undici": ">=6.23.0"
    },
    "patchedDependencies": {
      "elliptic@6.6.1": "patches/elliptic@6.6.1.patch"
    }
  }
}
