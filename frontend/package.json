    "check:agent-discoverability": "node scripts/check-agent-discoverability.mjs",
    "verify:protocol-assets": "node scripts/verify-protocol-assets.mjs",
    "verify:base-app-icon-production": "node scripts/ops/verify-base-app-icon-production.mjs",
    "guard:server-core-boundary": "node scripts/check-server-core-boundary.mjs",
    "guard:frontend-boundaries": "node scripts/check-frontend-boundaries.mjs",
    "guard:schema": "node scripts/guard-no-raw-schema-ddl.mjs",
    "guard:canonical-csw": "node scripts/guard-no-legacy-canonical-csw-env.mjs",
    "test:guard:canonical-csw": "node --test scripts/guard-no-legacy-canonical-csw-env.test.mjs",
    "verify:schema-ensures": "tsx scripts/verify-post-migration-schema-ensures.ts",
    "builder-codes:verify": "if [ -f .env ]; then tsx --env-file=.env scripts/verify-builder-codes.ts; else tsx scripts/verify-builder-codes.ts; fi",
    "builder-codes:assert-env": "tsx scripts/assert-builder-codes-env.ts",
    "deploy:autopilot": "node scripts/deploy-autopilot.mjs",
    "skills:sync:cursor": "node scripts/sync-cursor-skills.mjs --prune",
    "ops:refresh-ethos-charts": "tsx scripts/ops/refresh-ethos-chart-data.ts",
    "ops:trigger-ethos-refresh": "tsx scripts/ops/trigger-ethos-refresh.ts"
