PROVISIONER_HOST=127.0.0.1
PROVISIONER_PORT=8788
# Shared bearer secret for POST /setup-creator, POST /create-pool,
# POST /send-lottery-oapp, and POST /meteora-ixs.
# Mirror this value into app runtime env:
# - SOLANA_HOOK_PROVISIONER_SECRET
# - SOLANA_METEORA_POOL_PROVISIONER_SECRET
# - METEORA_IX_PROVISIONER_SECRET
PROVISIONER_BEARER_TOKEN=replace-with-long-random-secret

# Minimum payer balance guardrail for /healthz readiness.
PROVISIONER_MIN_PAYER_SOL=0.05
PROVISIONER_HEALTH_DEBUG=0
PROVISIONER_EXTENDED_ENDPOINTS=0

# B2 send-only LayerZero OApp. Keep disabled through all offline/preflight work.
SOLANA_LOTTERY_OAPP_SEND_ENABLED=0
SOLANA_LOTTERY_WINNER_SETTLEMENT_ENABLED=0
# Production reviewed identity: GgsdTRxKozPwYAiBhhsaVWGC76CMpSu5rtdwFhHMX2WB
SOLANA_LOTTERY_OAPP_PROGRAM_ID=
# Informational/readiness mirror: must equal SOLANA_KEEPER_KEYPAIR pubkey.
# Production reviewed operator: 7Qi3WW7q4kmqXcMBca76b3WjNMdRmjjjrpG5FTc8htxY
SOLANA_LOTTERY_OAPP_OPERATOR_PUBKEY=

# POST /setup-creator and POST /create-pool require the keeper scripts directory.
# Set to the repo root (the provisioner appends /kpr automatically).
KPR_REPO_ROOT=/opt/4626

# Solana config for setup-creator and OApp send transactions.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58 or JSON array secret key for the Solana keeper/payer.
SOLANA_KEEPER_KEYPAIR=

# Enforce strict SOL quote-mint policy for pool creation and mapping compatibility.
# Default should stay enabled in production.
SOLANA_STRICT_SOL_PAIR=1
# Canonical Meteora DLMM program used in the hook AMM allowlist.
SOLANA_METEORA_DLMM_PROGRAM_ID=LBUZKhRxPF3XUpBCjp4YzTKgLccjZhTSDM9YuVaPwxo
# Required before /create-pool: the regular OFT program must own the mapped mint authority.
SOLANA_OFT_PROGRAM_ID=
# Quote token for the DLMM pool (default: wrapped SOL).
# Ignored when SOLANA_STRICT_SOL_PAIR=1.
SOLANA_POOL_QUOTE_MINT=So11111111111111111111111111111111111111112
# DLMM bin step (default: 25 = 0.25% per bin)
SOLANA_POOL_BIN_STEP=25
# Pool fee in basis points (default: 100 = 1%)
SOLANA_POOL_FEE_BPS=100
