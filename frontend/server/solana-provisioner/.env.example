PROVISIONER_HOST=0.0.0.0
PROVISIONER_PORT=8788
# Shared bearer secret for POST /provision and POST /meteora-ixs
PROVISIONER_BEARER_TOKEN=replace-with-long-random-secret

# Base RPC used to verify scalar(route) after wrap-token
BASE_RPC_URL=https://mainnet.base.org

# Bridge CLI runtime configuration
SOLANA_BRIDGE_CLI_DIR=/abs/path/to/base-bridge/scripts
# CLI runner: auto | bun | pnpm | npm | cli
SOLANA_BRIDGE_CLI_BIN=auto
SOLANA_BRIDGE_DEPLOY_ENV=mainnet
SOLANA_BRIDGE_PAYER_KP=config
SOLANA_BRIDGE_SCALER_EXPONENT=9
# Optional: set empty to remove prefix (symbol will default to address-based suffix).
SOLANA_BRIDGE_WRAP_SYMBOL_PREFIX=
# Symbol mode for wrap-token metadata:
# - auto: prefer Unicode (e.g. ■AKITA), fallback to deterministic ASCII on incompatibility
# - unicode: always send Unicode symbol
# - ascii: always send deterministic ASCII symbol
SOLANA_BRIDGE_WRAP_SYMBOL_MODE=auto
SOLANA_BRIDGE_PAY_FOR_RELAY=1
# Retry transient Solana RPC failures (e.g. blockhash churn) before returning 500.
PROVISIONER_WRAP_RETRY_ATTEMPTS=3
PROVISIONER_WRAP_RETRY_DELAY_MS=1200

# POST /setup-creator and POST /create-pool require CRE scripts directory.
# Set to the repo root (the provisioner appends /cre automatically).
CRE_REPO_ROOT=/opt/creatorvault

# Solana config for setup-creator (Token-2022 mint + PDA init)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58 or JSON array secret key for the Solana keeper/payer.
SOLANA_KEEPER_KEYPAIR=
