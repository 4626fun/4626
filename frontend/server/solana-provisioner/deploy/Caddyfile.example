# Replace provisioner.example.com with your real host.
provisioner.example.com {
  encode zstd gzip

  @health path /healthz
  handle @health {
    reverse_proxy 127.0.0.1:8788
  }

  @mutations path /meteora-ixs /setup-creator /create-pool
  handle @mutations {
    reverse_proxy 127.0.0.1:8788
  }

  # Default deny for everything else.
  respond "Not found" 404
}
