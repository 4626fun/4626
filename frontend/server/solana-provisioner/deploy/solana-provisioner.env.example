# Runtime bind
PROVISIONER_HOST=127.0.0.1
PROVISIONER_PORT=8788

# Shared secret for app -> provisioner calls
PROVISIONER_BEARER_TOKEN=replace-with-long-random-secret

# Active hook and Meteora endpoints
PROVISIONER_EXTENDED_ENDPOINTS=1
KPR_REPO_ROOT=/opt/4626
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_KEEPER_KEYPAIR=
SOLANA_STRICT_SOL_PAIR=1
SOLANA_POOL_QUOTE_MINT=So11111111111111111111111111111111111111112
SOLANA_POOL_BIN_STEP=25
SOLANA_POOL_FEE_BPS=100
