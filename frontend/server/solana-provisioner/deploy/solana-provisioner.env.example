# Runtime bind
PROVISIONER_HOST=127.0.0.1
PROVISIONER_PORT=8788

# Shared secret for app -> provisioner calls
PROVISIONER_BEARER_TOKEN=replace-with-long-random-secret

# Base RPC used to verify scalar(route) after wrap-token
BASE_RPC_URL=https://mainnet.base.org

# Bridge CLI runtime configuration
SOLANA_BRIDGE_CLI_DIR=/opt/base-bridge/scripts
# CLI runner: auto | bun | pnpm | npm | cli
SOLANA_BRIDGE_CLI_BIN=auto
SOLANA_BRIDGE_DEPLOY_ENV=mainnet
SOLANA_BRIDGE_PAYER_KP=config
SOLANA_BRIDGE_SCALER_EXPONENT=9
# wrap-token receives the exact Base ERC-20 name/symbol (strict parity mode).
# No env var configures the Solana mint's display name; rename the creator
# coin on Base instead and re-provision, or update the mint's Token-2022
# tokenMetadata extension with `spl-token update-metadata` using the mint's
# update-authority keypair.
# Optional: include `--metadata-uri` when running wrap-token.
# Keep disabled unless your bridge CLI version supports the flag.
SOLANA_BRIDGE_WRAP_METADATA_URI_ENABLED=0
SOLANA_BRIDGE_PAY_FOR_RELAY=1
# Retry transient Solana RPC failures (e.g. blockhash churn) before returning 500.
PROVISIONER_WRAP_RETRY_ATTEMPTS=3
PROVISIONER_WRAP_RETRY_DELAY_MS=1200
