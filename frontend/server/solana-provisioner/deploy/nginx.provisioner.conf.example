server {
  listen 443 ssl http2;
  server_name provisioner.example.com;

  # TLS cert config is environment-specific:
  # ssl_certificate /etc/letsencrypt/live/provisioner.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/provisioner.example.com/privkey.pem;

  location = /healthz {
    proxy_pass http://127.0.0.1:8788;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /provision {
    proxy_pass http://127.0.0.1:8788;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    return 404;
  }
}
