[Unit]
Description=4626 Solana route provisioner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=app4626
Group=app4626
# install-systemd.sh rewrites these placeholders per host.
WorkingDirectory=/opt/4626/frontend
EnvironmentFile=/etc/4626/solana-provisioner.env
ExecStart=/usr/bin/env pnpm --dir /opt/4626/frontend solana-provisioner:start
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
