# --------------------------------------------------------------------------
# 4626 Agent — Production Dockerfile (primarily for Keepr / general agents)
# --------------------------------------------------------------------------
# For the dedicated Hermit creative service (hermit.4626.fun), use the
# separate dedicated image instead:
#
#   frontend/Dockerfile.hermit
#
# This keeps the Hermit startup path as simple and reliable as possible.
# --------------------------------------------------------------------------

FROM node:22-bookworm-slim AS base

# Install OS deps for native modules (sharp, XMTP bindings) + gosu for entrypoint
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ ca-certificates gosu \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@10.15.1 --activate

WORKDIR /app

# --------------------------------------------------------------------------
# Stage 1: Install dependencies
# --------------------------------------------------------------------------
FROM base AS deps

# Copy package manifests + patch files (referenced by pnpm.patchedDependencies)
COPY frontend/package.json frontend/pnpm-lock.yaml ./
# Use the frontend workspace patches directory because pnpm resolves
# `patchedDependencies` paths relative to the package.json being installed
# (frontend/package.json). The repo-root `patches/` is for the Solidity
# workspace and does not contain frontend patches.
COPY frontend/patches/ ./patches/

# Include @4626/server-core (workspace package) so pnpm can resolve the
# workspace:* link during install. Command families and server/_lib modules
# import from dist/ at runtime — build.mjs must run in this stage.
COPY frontend/packages/server-core/package.json ./packages/server-core/package.json
COPY frontend/packages/server-core/tsconfig.json ./packages/server-core/tsconfig.json
COPY frontend/packages/server-core/build.mjs ./packages/server-core/build.mjs
COPY frontend/packages/server-core/src ./packages/server-core/src

COPY frontend/server ./server
COPY frontend/api/_handlers/token ./api/_handlers/token
COPY frontend/src/config ./src/config
COPY frontend/src/lib ./src/lib
COPY frontend/src/wallet ./src/wallet

# Install ALL deps (tsx, @elizaos/core are in devDependencies).
# Use --ignore-scripts first to avoid OOM from parallel native builds,
# then rebuild native modules sequentially.
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm rebuild

RUN cd packages/server-core && node build.mjs

# --------------------------------------------------------------------------
# Stage 2: Production image
# --------------------------------------------------------------------------
FROM base AS runner

WORKDIR /app

# Copy installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy the server-core workspace package (dist + runtime siblings from build.mjs).
COPY --from=deps /app/packages/server-core ./packages/server-core

# server tree includes build.mjs runtime siblings (e.g. renderPremiumTokenIcon.js)
COPY --from=deps /app/server ./server
COPY frontend/api ./api
COPY frontend/src/config ./src/config
COPY frontend/src/lib ./src/lib
COPY frontend/src/wallet ./src/wallet
COPY frontend/tsconfig.json frontend/tsconfig.node.json ./
COPY frontend/shared ./shared

# Create persistent XMTP database directory
# Mount a volume here to preserve agent installations across restarts
RUN mkdir -p /data/.xmtp-data

# Health check port (tiny HTTP server in the agent)
ENV PORT=8080
EXPOSE 8080

# XMTP database persistence
ENV XMTP_DB_DIRECTORY=/data/.xmtp-data

# Entrypoint: volume permissions, then bootstrap.ts (health listener before heavy imports).
CMD ["bash", "-lc", "if [ \"${AGENT_PROCESS:-keepr}\" = \"hermit\" ]; then exec ./node_modules/.bin/tsx server/agents/hermit/bootstrap.ts; fi; install -d -m 0755 /data/.xmtp-data && find /data/.xmtp-data -xdev -exec chown -h node:node {} + && exec gosu node ./node_modules/.bin/tsx server/agents/eliza/bootstrap.ts"]
