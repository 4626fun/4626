{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "api/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "api/**/*.test.ts",
    "api/**/*.test.tsx",
    "src/**/__tests__/**",
    "api/**/__tests__/**"
  ]
}
