# Active Vercel root is `frontend/`.
# Keep generated output, local caches, and secrets out of every upload.

# Developer diagnostic pages must never ship to production (see audit M-25, M-27 / 4626-334, 4626-336).
public/csw-diag.html
public/*-diag.html

# Dependencies
node_modules
**/node_modules

# Build output / caches
dist
**/dist
coverage
**/coverage
.cache
.eslintcache
.next
**/.next
.turbo
**/.turbo
.vite
**/.vite
.vercel
**/.vercel
.xmtp-data
**/.xmtp-data
playwright-report
**/playwright-report
test-results
**/test-results
tmp
*.log
*.tsbuildinfo

# Tooling-only workspaces / test assets not needed for Vercel builds
v4-subgraph
docs
**/docs
**/__tests__
**/*.test.*
**/*.spec.*

# Local env / secrets
.env
.env.*
.env.local
.env*.local

# Editor / OS noise
.DS_Store
