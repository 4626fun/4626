{
  "buildCommand": "pnpm run builder-codes:assert-env && pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "framework": "vite",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/agent-registration.ts": {
      "includeFiles": "public/.well-known/agent-registration.json"
    },
    "api/keepr/actions/execute.ts": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/.pnpm/**/bindings_node.darwin*.node,node_modules/.pnpm/**/bindings_node.win32*.node,node_modules/.pnpm/**/bindings_node.linux-arm64*.node,node_modules/.pnpm/**/bindings_node.linux-x64-musl.node}"
    },
    "api/agent/process.ts": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/.pnpm/**/bindings_node.darwin*.node,node_modules/.pnpm/**/bindings_node.win32*.node,node_modules/.pnpm/**/bindings_node.linux-arm64*.node,node_modules/.pnpm/**/bindings_node.linux-x64-musl.node}"
    },
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-creator-metrics",
      "schedule": "*/5 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.4626.fun"
        }
      ],
      "status": 308,
      "dest": "https://4626.fun/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "content-security-policy-report-only": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://telegram.org https://ajax.googleapis.com; script-src-elem 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://telegram.org https://ajax.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.choicecdn.com https://imagedelivery.net https://metadata.ens.domains https://euc.li https://grails.app https://efp.app https://ipfs.decentralized-content.com https://raw.githubusercontent.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; child-src https://auth.privy.io https://privy.app.4626.fun https://privy.4626.fun https://oauth.telegram.org https://vercel.live https://dexscreener.com https://www.dexscreener.com; frame-src https://auth.privy.io https://privy.app.4626.fun https://privy.4626.fun https://oauth.telegram.org https://challenges.cloudflare.com https://vercel.live https://dexscreener.com https://www.dexscreener.com; connect-src 'self' https://auth.privy.io https://api.developer.coinbase.com https://base-mainnet.g.alchemy.com https://*.g.alchemy.com wss://www.walletlink.org https://*.rpc.privy.systems https://rpc.zora.energy https://mainnet.base.org https://api.production.xmtp.network:5558 https://*.xmtp.network:5558 https://*.xmtp.network:* wss://*.xmtp.network:* https://ipfs.decentralized-content.com https://api.lens.xyz https://ccip.ens.xyz; worker-src 'self' blob:; manifest-src 'self'",
        "referrer-policy": "strict-origin-when-cross-origin",
        "x-content-type-options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/.well-known/agent-registration.json",
      "headers": { "cache-control": "no-store" },
      "dest": "/api/agent-registration"
    },
    {
      "src": "/manifest.json",
      "headers": { "cache-control": "no-store" },
      "continue": true
    },
    {
      "src": "/.well-known/farcaster.json",
      "headers": { "cache-control": "no-store" },
      "continue": true
    },
    {
