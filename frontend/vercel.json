{
  "buildCommand": "pnpm run builder-codes:assert-env && pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "framework": "vite",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/agent-registration.ts": {
      "includeFiles": "public/.well-known/agent-registration.json"
    },
    "api/sync-creator-metrics.ts": {
      "maxDuration": 60
    },
    "api/keepr/actions/execute.ts": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/.pnpm/**/bindings_node.darwin*.node,node_modules/.pnpm/**/bindings_node.win32*.node,node_modules/.pnpm/**/bindings_node.linux-arm64*.node,node_modules/.pnpm/**/bindings_node.linux-x64-musl.node}"
    },
    "api/agent/process.ts": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/.pnpm/**/bindings_node.darwin*.node,node_modules/.pnpm/**/bindings_node.win32*.node,node_modules/.pnpm/**/bindings_node.linux-arm64*.node,node_modules/.pnpm/**/bindings_node.linux-x64-musl.node}"
    },
    "api/image/**/*.ts": {
      "maxDuration": 60
    },
    "api/token/image.ts": {
      "maxDuration": 60
    },
    "api/v1/[...path].ts": {
      "maxDuration": 60
    },
    "api/auth/[...path].ts": {
      "maxDuration": 60
    },
    "api/waitlist.ts": {
      "maxDuration": 60
    },
    "api/waitlist/[...path].ts": {
      "maxDuration": 60
    },
    "api/telegram/[...path].ts": {
      "maxDuration": 60
    },
    "api/uniswap/[...path].ts": {
      "maxDuration": 60
    },
    "api/zora/[...path].ts": {
      "maxDuration": 60
    },
    "api/lens/[...path].ts": {
      "maxDuration": 60
    },
    "api/keepr/[...path].ts": {
      "maxDuration": 60
    },
    "api/cre/[...path].ts": {
      "maxDuration": 60
    },
    "api/telegram/webhook.ts": {
      "maxDuration": 60
    },
    "api/deploy/solanaInfraStatus.ts": {
      "maxDuration": 60
    },
    "api/deploy/provisionSolanaRoute.ts": {
      "maxDuration": 60
    },
    "api/deploy/registerSolanaBridgeToken.ts": {
      "maxDuration": 60
    },
    "api/wallet/solana/**/*.ts": {
      "maxDuration": 60
    },
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-creator-metrics",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/telegram/arena/watch-tick",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.4626.fun"
        }
      ],
      "status": 308,
      "dest": "https://4626.fun/$1"
    },
    {
      "src": "/(.*)",
      "headers": {
        "content-security-policy-report-only": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.choicecdn.com https://imagedelivery.net https://metadata.ens.domains https://euc.li https://grails.app https://efp.app; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; child-src https://auth.privy.io https://privy.app.4626.fun https://privy.4626.fun https://oauth.telegram.org https://vercel.live https://dexscreener.com https://www.dexscreener.com; frame-src https://auth.privy.io https://privy.app.4626.fun https://privy.4626.fun https://oauth.telegram.org https://challenges.cloudflare.com https://vercel.live https://dexscreener.com https://www.dexscreener.com; connect-src 'self' https://auth.privy.io https://api.developer.coinbase.com https://base-mainnet.g.alchemy.com https://*.g.alchemy.com wss://www.walletlink.org https://*.rpc.privy.systems https://rpc.zora.energy https://mainnet.base.org https://api.production.xmtp.network:5558 https://*.xmtp.network:5558 https://*.xmtp.network:* wss://*.xmtp.network:*; worker-src 'self' blob:; manifest-src 'self'",
        "referrer-policy": "strict-origin-when-cross-origin",
        "x-content-type-options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/.well-known/agent-registration.json",
      "headers": { "cache-control": "no-store" },
      "dest": "/api/agent-registration"
    },
    {
      "src": "/manifest.json",
      "headers": { "cache-control": "no-store" },
      "continue": true
    },
    {
      "src": "/.well-known/farcaster.json",
      "headers": { "cache-control": "no-store" },
      "continue": true
    },
    {
      "src": "/explore/(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/swap",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/trade",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/positions",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/portfolio",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/vault/(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/deploy",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/leaderboard",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/waitlist(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/profile/(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/account",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/faq(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/auction/(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/gauge(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/earnings(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/coin/(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/status",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/dashboard",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/agents(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/admin(.*)",
      "headers": { "x-robots-tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/index.html",
      "headers": { "cache-control": "no-store" },
      "continue": true
    },
    {
      "src": "/app.html",
      "headers": { "cache-control": "no-store" },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "app.4626.fun"
        }
      ],
      "dest": "/app.html"
    },
    { "src": "/__api/(.*)", "dest": "/api/$1", "continue": true },
    { "src": "/api/sync-creator-metrics", "dest": "/api/sync-creator-metrics" },
    { "src": "/api/keepr/actions/execute", "dest": "/api/keepr/actions/execute" },
    { "src": "/api/agent/process", "dest": "/api/agent/process" },
    { "src": "/api/auth/(.*)", "dest": "/api/auth/[...path]?path=$1" },
    { "src": "/api/waitlist", "dest": "/api/waitlist" },
    { "src": "/api/waitlist/(.*)", "dest": "/api/waitlist/[...path]?path=$1" },
    { "src": "/api/token/image", "dest": "/api/token/image" },
    { "src": "/api/v1/token/([a-fA-F0-9x]+)/image", "dest": "/api/token/image?address=$1" },
    { "src": "/api/v1/token/([a-fA-F0-9x]+)/logo\\.(png|svg)", "dest": "/api/token/image?address=$1&format=$2&size=64" },
    { "src": "/api/v1/(.*)", "dest": "/api/v1/[...path]?path=$1" },
    { "src": "/api/telegram/webhook", "dest": "/api/telegram/webhook" },
    { "src": "/api/telegram/(.*)", "dest": "/api/telegram/[...path]?path=$1" },
    { "src": "/api/uniswap/(.*)", "dest": "/api/uniswap/[...path]?path=$1" },
    { "src": "/api/zora/(.*)", "dest": "/api/zora/[...path]?path=$1" },
    { "src": "/api/lens/(.*)", "dest": "/api/lens/[...path]?path=$1" },
    { "src": "/api/keepr/(.*)", "dest": "/api/keepr/[...path]?path=$1" },
    { "src": "/api/cre/(.*)", "dest": "/api/cre/[...path]?path=$1" },
    { "src": "/api/image/projects/(.*)", "dest": "/api/image/projects/$1" },
    { "src": "/api/image/jobs/status", "dest": "/api/image/jobs/status" },
    { "src": "/api/image/external", "dest": "/api/image/external" },
    { "src": "/api/deploy/solanaInfraStatus", "dest": "/api/deploy/solanaInfraStatus" },
    { "src": "/api/deploy/provisionSolanaRoute", "dest": "/api/deploy/provisionSolanaRoute" },
    { "src": "/api/deploy/registerSolanaBridgeToken", "dest": "/api/deploy/registerSolanaBridgeToken" },
    { "src": "/api/wallet/solana/(.*)", "dest": "/api/wallet/solana/$1" },
    { "src": "/api/(.*)", "dest": "/api/[...path]?path=$1" },
    { "handle": "filesystem" },
    {
      "src": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "app.4626.fun"
        }
      ],
      "dest": "/app.html"
    },
    { "src": "/((?!assets/).*)", "dest": "/index.html" }
  ]
}
