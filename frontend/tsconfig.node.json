{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "api/**/*.ts",
    "api/_handlers/**/*.ts",
    "server/_lib/**/*.ts",
    "server/auth/**/*.ts",
    "server/debank/**/*.ts",
    "server/dexscreener/**/*.ts",
    "server/farcaster/**/*.ts",
    "server/zora/**/*.ts",
    "server/keepr/**/*.ts",
    "server/ai/**/*.ts",
    "server/agent/**/*.ts",
    "src/config/contracts.defaults.ts"
  ]
}
