{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@4626/server-core": ["./packages/server-core/src/index.ts"],
      "@4626/server-core/*": ["./packages/server-core/src/*"]
    }
  },
  "include": [
    "src/vite-env.d.ts",
    "vite.config.ts",
    "packages/server-core/src/**/*.ts",
    "api/**/*.ts",
    "api/_handlers/**/*.ts",
    "api/_handlers/**/*.d.ts",
    "server/_lib/**/*.ts",
    "server/_lib/**/*.d.ts",
    "shared/payout-router/harvestCommon.ts",
    "shared/payout-router/harvestExecute.ts",
    "shared/payout-router/revenueRouter4626Abi.ts",
    "server/auth/**/*.ts",
    "server/debank/**/*.ts",
    "server/dexscreener/**/*.ts",
    "server/commands/**/*.ts",
    "server/twitter/**/*.ts",
    "server/zora/**/*.ts",
    "server/uniswap/**/*.ts",
    "server/cdp/**/*.ts",
    "server/keepr/**/*.ts",
    "server/ai/**/*.ts",
    "server/agents/**/*.ts",
    "scripts/**/*.d.ts",
    "scripts/ops/hookBytecodeClassify.ts",
    "scripts/ops/preflight-solana-b2-onchain.ts",
    "scripts/ops/preflight-solana-devnet.ts",
    "scripts/ops/preflight-solana-lz-dvns.ts",
    "scripts/ops/preflight-solana-lottery-oapp.ts",
    "scripts/ops/preflight-solana-lottery-test-route.ts",
    "scripts/ops/configure-lottery-relay-test-receiver-uln.ts",
    "scripts/ops/configure-solana-lottery-test-oapp-uln.ts",
    "scripts/ops/configure-solana-lottery-test-oapp-send-library.ts",
    "scripts/ops/init-solana-lottery-test-oapp-nonce.ts",
    "scripts/ops/bootstrap-solana-lottery-mainnet-oapp.ts",
    "scripts/ops/configure-lottery-relay-mainnet-uln.ts",
    "scripts/ops/configure-lottery-relay-mainnet-binding.ts",
    "scripts/ops/send-solana-lottery-test-oapp-packet.ts",
    "scripts/ops/canary-room1659-sudoswap-round-trip.ts",
    "scripts/ops/create-room1659-sudoswap-pair-csw.ts",
    "scripts/ops/solanaMintArgument.ts",
    "scripts/ops/verify-inverse-akita-trade-journal.ts",
    "scripts/ops/check-native-aa-readiness.ts",
    "src/config/contracts.defaults.ts",
    "src/config/contracts.ts",
    "src/config/remoteShareOftChains.ts",
    "src/deploy/**/*.ts",
    "src/lib/cca/**/*.ts",
    "src/lib/deploy/**/*.ts",
    "src/lib/deploy/create2Salts.ts",
    "src/lib/deploy/deploymentBatcherConfigError.ts",
    "src/lib/flags/**/*.ts",
    "src/lib/observability/**/*.ts",
    "src/lib/onchain/agentTokenIntegration.ts",
    "src/lib/onchain/resolveAgentTokenIntegration.ts",
    "src/lib/uniswap/swapQuoteSanitize.ts",
    "src/lib/xmtp/xmtpInteractive.ts",
    "src/lib/xmtp/xmtpHelpers.ts",
    "src/lib/xmtp/xmtpSyncCoordinator.ts",
    "src/lib/alfaclub/keyDefense.ts",
    "src/lib/alfaclub/roomLabel.ts",
    "src/lib/alfaclub/contracts.ts",
    "src/lib/alfaclub/sudoswapRouter.ts",
    "src/lib/alfaclub/zoraFundingExecute.ts",
    "src/lib/alfaclub/zoraFundingExecuteFixtures.ts",
    "src/lib/api/**/*.ts",
    "src/lib/auth/**/*.ts",
    "src/lib/debank/**/*.ts",
    "src/components/account/trayPortfolioHelpers.ts",
    "src/lib/agent/erc8004AgentUriPolicy.ts",
    "src/lib/zora/migrationScan.ts",
    "src/lib/viteManualChunks.ts",
    "shared/deploy/bytecode.generated.ts",
    "shared/deploy/create2Salts.ts",
    "shared/deploy/impairmentAuxPlan.ts",
    "shared/deploy/payoutRouterInitCode.ts",
    "shared/wallet/bytecode.ts",
    "src/wallet/canonicalWalletPolicy.ts",
    "src/lib/env/**/*.ts",
    "src/lib/routes/**/*.ts",
    "src/lib/vanity/**/*.ts",
    "src/lib/relay/goldenRelayPart1Shape.ts",
    "src/lib/wallet/cswOwnerMutationEncode.ts",
    "src/lib/wallet/cswOwnerAbi.ts",
    "src/lib/wallet/addOwnerCallShape.ts",
    "src/lib/wallet/userExecutionTrack.ts",
    "src/pages/deploy/deployVaultHelpers.ts",
    "src/pages/deploy/deployVaultSignals.ts",
    "src/pages/deploy/deployVaultVanityPersistence.ts",
    "src/features/deploy-vault/deploySteps.ts",
    "src/features/status/nativeAaReadiness.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    // These tests pull in app-layer code outside the restricted server/node typecheck surface
    "server/_lib/wallet/cswOwnerSignature.test.ts",
    "server/_lib/wallet/zoraWalletHoldings.test.ts"
  ]
}
