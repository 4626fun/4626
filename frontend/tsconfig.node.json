{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "packages/server-core/src/**/*.ts",
    "api/**/*.ts",
    "api/_handlers/**/*.ts",
    "server/_lib/**/*.ts",
    "server/auth/**/*.ts",
    "server/debank/**/*.ts",
    "server/dexscreener/**/*.ts",
    "server/commands/**/*.ts",
    "server/twitter/**/*.ts",
    "server/zora/**/*.ts",
    "server/uniswap/**/*.ts",
    "server/cdp/**/*.ts",
    "server/keepr/**/*.ts",
    "server/ai/**/*.ts",
    "server/agent/**/*.ts",
    "scripts/**/*.d.ts",
    "src/config/contracts.defaults.ts",
    "src/deploy/**/*.ts",
    "src/lib/deploy/create2Salts.ts",
    "src/lib/agent/erc8004AgentUriPolicy.ts",
    "src/lib/build/viteManualChunks.ts",
    "shared/deploy/bytecode.generated.ts",
    "shared/deploy/create2Salts.ts",
    "shared/wallet/bytecode.ts",
    "src/wallet/canonicalWalletPolicy.ts"
  ]
}
