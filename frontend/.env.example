# 4626 (Vite) environment variables
#
# Local dev:
#   cp .env.example .env
#   # then edit .env
#
# IMPORTANT:
# - Any variable starting with `VITE_` is bundled into the browser and is PUBLIC.
# - Never commit real API keys/secrets into this file.
#
# ------------------------------------------------------------
# Zora Coins SDK & referrals
# ------------------------------------------------------------
# Public key (safe to expose; restrict Allowed Origins in Zora)
VITE_ZORA_PUBLIC_API_KEY=
# Optional: sticky onchain platform referral recipient used when creating coins in-app.
# Must be a valid EVM address. If unset, app falls back to the current 4626 default.
VITE_ZORA_PLATFORM_REFERRER_ADDRESS=
# Optional: Zora invite/referral handoff URL used for first-time Zora onboarding.
# Recommended: set this to your account's full invite link from https://zora.co/invite
VITE_ZORA_INVITE_URL=
#
# Server-only key used by Vercel Functions (do NOT prefix with VITE_)
# Set this in Vercel Project Settings → Environment Variables.
# Also used by read-only Zora CLI compatibility endpoints under `/api/zora/cli/*`.
# Do not add ZORA_PRIVATE_KEY for production API execution paths in this app.
ZORA_SERVER_API_KEY=
# Trend automation (fail-closed defaults in code; explicit opt-in required)
# ZORA_TREND_AUTOMATION_ENABLED=false
# ZORA_TREND_FLYWHEEL_ENABLED=false
# ZORA_TREND_MAX_NOTIONAL_WEI=1000000000000000
# ZORA_TREND_MAX_SLIPPAGE_BPS=300
# ZORA_TREND_ROUTEABILITY_REQUIRED=true
# ZORA_TREND_FLYWHEEL_TARGET_TOKEN=0x0000000000000000000000000000000000000000
# ZORA_TREND_ALLOWED_TICKERS=BASEAI,MYTREND
# Launch sentinel (watch + reserve as soon as available)
# TREND_SENTINEL_ENABLED=false
# TREND_SENTINEL_SECRET=
# TREND_SENTINEL_TICKERS=AI,67,46
# TREND_SENTINEL_CREATOR_TOKEN=0x0000000000000000000000000000000000000000
# TREND_SENTINEL_GROUP_ID=trend-ai-launch-bot-v1
# TREND_SENTINEL_POLL_MS=800
# TREND_SENTINEL_JITTER_MS=400
# TREND_SENTINEL_REQUIRE_RECEIPT=true
# TREND_SENTINEL_MAX_RUNTIME_MS=45000
# TREND_SENTINEL_MAX_CONSECUTIVE_ERRORS=20
# TREND_SENTINEL_DEADLINE_ISO=
#
# ------------------------------------------------------------
# The Graph Protocol (Uniswap V4 historical data)
# ------------------------------------------------------------
# Server-only API key for querying The Graph decentralized network.
# Get yours at: https://thegraph.com/studio/apikeys/
# Enables 1h, 1w, 1m, 1y timeframe filters on Explore pages.
# Either THEGRAPH_API_KEY or GRAPH_API_KEY works.
GRAPH_API_KEY=
#
#
# Grove (Lens content-addressed storage) chain ID.
# Default: 232 (Lens Mainnet). Set to 8453 for Base-specific data (vault metadata, on-chain reputation).
# GROVE_CHAIN_ID=232
#
# Optional: Override the default subgraph ID (defaults to 4626 subgraph)
# UNISWAP_V4_BASE_SUBGRAPH_ID=Gqm2b5J85n1bhCyDMpGbtbVn4935EvvdyHdHrx3dibyj
#
# ------------------------------------------------------------
# Uniswap Trading API (server-side quote/swap builder)
# ------------------------------------------------------------
# Server-only API key used by /api/uniswap/{quote,swap,checkApproval,swap5792,swap7702,plan}
# Docs: https://api-docs.uniswap.org/guides/integration_guide
UNISWAP_API_KEY=
# Back-compat alias (if you already use this name in local envs)
UNISWAP_API=
# Optional: override trading API base URL (default shown)
# UNISWAP_TRADE_API_BASE=https://trade-api.gateway.uniswap.org/v1
# Optional: strict server-side guardrails for chain/token/route policy.
# Defaults to Base mainnet only when unset.
# UNISWAP_ALLOWED_CHAIN_IDS=8453
# UNISWAP_MAX_INPUT_BASE_UNITS=
# UNISWAP_TOKEN_ALLOWLIST=
# UNISWAP_TOKEN_DENYLIST=
# UNISWAP_ALLOWED_ROUTE_TYPES=CLASSIC,WRAP,UNWRAP,BRIDGE,DUTCH_V3
# Optional: paymaster-side Permit2 cap for sponsored ops.
# UNISWAP_PAYMASTER_MAX_PERMIT2_AMOUNT=
# Client-side policy mirror (defense in depth + UX messaging).
# VITE_UNISWAP_POLICY_ENABLED=1
# VITE_UNISWAP_MAX_SLIPPAGE_BPS=
# VITE_UNISWAP_MAX_INPUT_BASE_UNITS=
# VITE_UNISWAP_ALLOWED_ROUTE_TYPES=
# VITE_UNISWAP_TOKEN_ALLOWLIST=
# VITE_UNISWAP_TOKEN_DENYLIST=
# Internal diagnostics and 7702 canary controls.
# VITE_UNISWAP_INTERNAL_DIAGNOSTICS=0
# VITE_UNISWAP_7702_CANARY_ENABLED=0
# VITE_UNISWAP_7702_CANARY_ALLOWLIST=
# Swap provider rollout mode: uniswap | cdp | hybrid (default: uniswap)
# - uniswap: existing provider only
# - cdp: CDP provider only
# - hybrid: prefer CDP with controlled fallback to Uniswap
VITE_SWAP_PROVIDER=uniswap
# ------------------------------------------------------------
# Coinbase Developer Platform (OnchainKit)
# ------------------------------------------------------------
# Recommended: point the client at our same-origin proxy.
# This keeps your real CDP endpoint off the public bundle, and lets the backend
# enforce a strict allowlist (required for "1-click deploy any Creator Coin").
# Note: the proxy requires a SIWE session cookie (see AUTH_SESSION_SECRET below).
VITE_CDP_PAYMASTER_URL=/api/paymaster
# Direct CDP paymaster URL for wallet_sendCalls (ERC-7677).
# The CSW extension calls this URL directly (not through the session-protected proxy),
# so it must be the actual CDP endpoint e.g. https://api.developer.coinbase.com/rpc/v1/base/<API_KEY>
# If unset, wallet_sendCalls will be attempted without paymaster capabilities.
VITE_CDP_SENDCALLS_PAYMASTER_URL=
# Optional: include paymaster debug context in JSON-RPC denial messages.
# Useful while diagnosing phase-specific sponsorship rejections.
# Set to 1/true temporarily, then disable.
VITE_PAYMASTER_DEBUG=
#
# Server-only: the real CDP paymaster/bundler endpoint (KEEP SECRET).
# Example: https://api.developer.coinbase.com/rpc/v1/base/<CDP_API_KEY_ID>
CDP_PAYMASTER_URL=

# ------------------------------------------------------------
# One-click deploy deterministic "slate"
# ------------------------------------------------------------
# This string is passed into phased deploy calls and is used as a deterministic namespace tag.
# Changing it gives everyone a fresh address namespace (prevents collisions / partial replays).
VITE_DEPLOYMENT_VERSION=v1.8.3
# Optional minimum initial creator-token deposit (whole tokens, no decimals).
# Deploy flow enforces a 50M-token policy to match onchain DeploymentBatcher checks.
VITE_MIN_FIRST_DEPOSIT_TOKENS=50000000

#
# ------------------------------------------------------------
# Domain split (4626.fun vs app.4626.fun)
# ------------------------------------------------------------
# Optional overrides for host detection. Defaults:
#   VITE_APP_ORIGIN=https://app.4626.fun
#   VITE_MARKETING_ORIGIN=https://4626.fun
# To test the waitlist/marketing page on localhost, set:
#   VITE_HOST_MODE_OVERRIDE=marketing
#   VITE_MARKETING_ORIGIN=http://localhost:5173
# Vite dev server binding (secure default is localhost-only):
#   VITE_DEV_SERVER_HOST=true      # bind to 0.0.0.0
#   VITE_DEV_SERVER_HOST=0.0.0.0   # explicit host
# Optional explicit base URL for waitlist share links (defaults to VITE_MARKETING_ORIGIN):
#   VITE_WAITLIST_REFERRAL_BASE_URL=https://4626.fun
# Server-only: canonical app host for frames, token metadata, etc.
# APP_HOST=app.4626.fun

#
# ------------------------------------------------------------
# Public launch mode
# ------------------------------------------------------------
# If enabled, the SPA will only expose `/` and `/waitlist` publicly.
# All other routes will redirect back to `/`.
VITE_PUBLIC_SITE_MODE=
#
# Optional: show CSW ERC-1271 ownership proof CTA on waitlist verify step.
# Disabled by default to keep onboarding focused.
# VITE_WAITLIST_CSW_PROOF=true
#
# ------------------------------------------------------------
# Admin access
# ------------------------------------------------------------
# Admin wallet grants are server-side only.
# Configure `CREATOR_ACCESS_ADMIN_ADDRESSES` below (no public `VITE_` bypass).
#
# ------------------------------------------------------------
# Privy (Smart Wallets)
# ------------------------------------------------------------
# Server-side Privy credentials (used by Vercel API routes, e.g. `/api/waitlist`).
# NOTE: `PRIVY_APP_SECRET` is sensitive — do NOT expose as `VITE_…`.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
#
# Privy Wallet API (agentic wallets / deploy-session automation)
# ------------------------------------------------------------
# Authorization key private key (P-256) used to sign `privy-authorization-signature` headers.
# Format: `wallet-auth:<base64_pkcs8_private_key>`
PRIVY_WALLET_AUTHORIZATION_KEY=
#
# Owner id (recommended: key quorum id) used as `owner_id` when creating agent wallets.
PRIVY_WALLET_OWNER_ID=
#
# Policy id (optional but strongly recommended) to constrain the agent wallet.
PRIVY_WALLET_POLICY_ID=
#
# Waitlist admin approvals:
# By default, creator agents are NOT auto-enabled (explicit user opt-in required).
# Set to 1/true only if you intentionally want legacy auto-enable behavior.
WAITLIST_AUTO_ENABLE_AGENTS=
#
# Public app ID (safe to expose; restrict Allowed Origins in Privy).
VITE_PRIVY_APP_ID=
# Optional: explicit browser client ID from the Privy dashboard. Use this when your
# allowlisted origins are configured on an app client rather than the top-level app.
VITE_PRIVY_CLIENT_ID=
#
# Explicitly enable Privy integration (recommended to keep off unless you need embedded wallets).
# Set to 1/true to enable when the origin is allowlisted.
VITE_PRIVY_ENABLED=
# Optional: client-side Privy analytics are disabled by default to avoid noisy
# CORS/report-only console errors on auth.privy.io analytics endpoints.
# Set to 1/true only if you explicitly want browser analytics events.
# VITE_PRIVY_ENABLE_ANALYTICS=true
#
# Deploy: use server-side continuation for Phase2 finalize + Phase3+
VITE_DEPLOY_USE_SERVER_CONTINUE=
# Deploy mode:
# - default: existing behavior (wallet/owner fallbacks allowed)
# - no_eoa_strict: pure ERC-4337 via preconfigured Privy-owner signer only
VITE_DEPLOY_MODE=
# Payout router keeper resolution (server-side, used by /api/deploy/config + paymaster validation)
# Priority: PAYOUT_ROUTER_KEEPER -> CRE_KEEPER_ADDRESS -> KEEPR_ADDRESS
PAYOUT_ROUTER_KEEPER=0xAb6d5C10b03300326CD7fAb7267Ae192842967b5
CRE_KEEPER_ADDRESS=0xAb6d5C10b03300326CD7fAb7267Ae192842967b5
KEEPR_ADDRESS=0xAb6d5C10b03300326CD7fAb7267Ae192842967b5
# Optional deploy-time payout-router external swap approvals:
# comma- or space-separated addresses. If set, deploy flow auto-calls:
# - setExternalSwapTargetApproval(target, true)
# - setExternalSwapSpenderApproval(spender, true)
# These are used by the external aggregator lane (e.g. DefiLlama routes).
# If left empty, runtime defaults are used:
# targets:  0x6ff5693b99212da76ad316178a184ab56d299b43
# spenders: 0x000000000022D473030F116dDEE9F6B43aC78BA3,0x6ff5693b99212da76ad316178a184ab56d299b43
PAYOUT_ROUTER_EXTERNAL_SWAP_TARGETS=
PAYOUT_ROUTER_EXTERNAL_SWAP_SPENDERS=
# Optional helper for ops script:
# pnpm -C frontend exec tsx scripts/ops/payout-router-external-approvals-safe.ts
PAYOUT_ROUTER_ADDRESSES=
# Deploy bootstrap swap planner (client-side preference only).
# Provider options: defillama | 0x | uniswap
# VITE_DEPLOY_BOOTSTRAP_SWAP_PROVIDER=defillama
# VITE_DEPLOY_BOOTSTRAP_SWAP_ALLOW_FALLBACK=true
# VITE_DEPLOY_BOOTSTRAP_SWAP_SLIPPAGE_BPS=100
#
# IMPORTANT: To prevent Privy iframe/CSP issues from breaking wallet connect in production,
# this app only enables Privy on explicitly allowlisted origins (unless in local dev).
# `4626.fun` and `app.4626.fun` should be allowlisted, because
# auth and wallet-setup flows may begin from any supported web origin.
# Example:
#   VITE_PRIVY_ALLOWED_ORIGINS=http://localhost:5173 https://4626.fun https://app.4626.fun
VITE_PRIVY_ALLOWED_ORIGINS=
#
# Builder Code attribution (Base)
# Option A (recommended): comma-separated builder code(s) from base.dev settings.
# Example: VITE_BASE_BUILDER_CODES=bc_b7k3p9da
VITE_BASE_BUILDER_CODES=bc_3qzrlts1
# Option B: precomputed dataSuffix hex (takes effect when VITE_BASE_BUILDER_CODES is empty).
VITE_BASE_DATA_SUFFIX=0x62635f33717a726c7473310b0080218021802180218021802180218021
#
# ------------------------------------------------------------
# RPC
# ------------------------------------------------------------
VITE_BASE_RPC=https://mainnet.base.org
# Local deploy dry-run shortcut:
# - copy `.env.deploy-dry-run.example` to `.env.deploy-dry-run.local`
# - set `BASE_FORK_UPSTREAM_RPC_URL`
# - run `pnpm -C frontend dev:deploy-dry-run`
# The shell runner exports localhost `BASE_RPC_URL` / `VITE_BASE_RPC` for that process.
#
# ------------------------------------------------------------
# Base mainnet contracts (override defaults)
# ------------------------------------------------------------
VITE_REGISTRY=0x9D86e8FAfA39527c4FE13AAa8FBD2B424f9f65Fb
VITE_LOTTERY_MANAGER=0xd593A8A58BDf7E7448D2dAbDE0Ae3B2BAFDA1357
# Public-facing AMOE/lottery official rules URL (shown in the Free Entry card).
VITE_AMOE_OFFICIAL_RULES_URL=https://4626.fun/terms#lottery-amoe-official-rules
VITE_VRF_CONSUMER=0xdd25Ed1b3D258Ccc6D306a9a325Af1A7F96C7F47
VITE_VAULT_ACTIVATION_BATCHER=0x7Cc0050842433968cc7A0884d192b61FD0b46F63
VITE_FACTORY=0xC7E919899Fd4C0C4f6f4269a63046107f85848bB
# Current live deploy orchestrator (`DeploymentBatcher`, canonical `v1.8.3` release)
VITE_CREATOR_VAULT_BATCHER=0xcDbEeB764df9878ebAFbf101cc818370f703bC4F
# Optional alias for env-based cutovers. Current live value matches `VITE_CREATOR_VAULT_BATCHER`.
# VITE_CREATOR_VAULT_BATCHER_AUTO_HANDOFF=0xcDbEeB764df9878ebAFbf101cc818370f703bC4F
VITE_SOLANA_BRIDGE_ADAPTER=0x90F578A4e23c1cB8DDFE63fd496ED7F4474f2b00
# Optional client-side prefill for per-deploy Solana registration.
# You can still override these in the Deploy UI per token/deploy.
VITE_SOLANA_DEFAULT_MINT_BYTES32=
VITE_SOLANA_DEFAULT_MINT_DECIMALS=9
# ShareOFT vanity suffix (optional)
VITE_SHARE_OFT_VANITY_SUFFIX=4626
VITE_SHARE_OFT_VANITY_MAX_TRIES=1000000
VITE_CREATE2_FACTORY=0x4e59b44847b379578588920cA78FbF26c0B4956C
VITE_UNIVERSAL_BYTECODE_STORE=0xA009B1Bf8cB711c115d832AEb392156BA6A4112e
VITE_UNIVERSAL_CREATE2_DEPLOYER=0xFd2657b6f1905C3F0494942F618a68963CF792Ec
VITE_V4_POOL_MANAGER=0x498581fF718922c3f8e6A244956aF099B2652b2b
VITE_V4_TAX_HOOK=0xca975B9dAF772C71161f3648437c3616E5Be0088
VITE_CHAINLINK_ETH_USD=0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
VITE_WETH=0x4200000000000000000000000000000000000006
VITE_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
VITE_PROTOCOL_TREASURY=0x7d429eCbdcE5ff516D6e0a93299cbBa97203f2d3
VITE_ZORA_USDC_V3_POOL=0xEdc625b74537ee3A10874f53D170e9C17a906B9c
VITE_ZORA_WETH_V3_POOL=0xA0Ca5BEBC42Cdbf3623b1C09206aE4E3975b0Fc7

# ve(3,3) + rewards ecosystem (set once deployed on Base)
VITE_VAULT_GAUGE_VOTING=
VITE_VOTER_REWARDS_DISTRIBUTOR=
VITE_BRIBES_FACTORY=
VITE_VE4626=
VITE_VE_BOOST_MANAGER=

# Production safety:
# By default, production ignores VITE_* contract overrides and uses repo defaults (BASE_DEFAULTS).
# Set to 1 if you intentionally want prod to honor VITE_* overrides.
VITE_ALLOW_CONTRACT_OVERRIDES=
# Server-side equivalent for `/api/*` routes on Vercel:
# keep unset/0 in production to force repo defaults and prevent stale override drift.
ALLOW_API_CONTRACT_OVERRIDES=
# XMTP network for browser chat client: production | dev | local
VITE_XMTP_ENV=production
#
# ------------------------------------------------------------
# Optional backend (Vercel Functions)
# ------------------------------------------------------------
# Supabase (recommended for Creator Access gate)
# ------------------------------------------------------------
# Browser-safe (PUBLIC; bundled into client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Server-only (Vercel Functions). Set these in Vercel Project Settings → Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
#
# Runtime app origin for server-to-server callbacks and auth/session validation (server-only).
# Used to avoid host-header spoofing in deploy-session automation.
APP_ORIGIN=
# Canonical marketing origin (server-only, optional) for public metadata links.
MARKETING_ORIGIN=

# ERC-8004 agent registration: see the dedicated section below (lines ~239+).

# Deploy-session automation (server-only):
# Enables "1-click" phased deployment by allowing the backend to complete Phase 2/3 via a temporary
# smart-wallet owner signer, gated by our `/api/paymaster` validations.
DEPLOY_SESSION_TOKEN_HMAC_SECRET=
# Bootstrap swap provider policy for /api/deploy/session/bootstrapSwap:
# DEPLOY_BOOTSTRAP_ALLOWED_PROVIDERS=uniswap,0x,defillama
# DEPLOY_BOOTSTRAP_SWAP_DEFAULT_PROVIDER=uniswap
# ZEROX_API_KEY=
# ZEROX_API_BASE=https://api.0x.org
# DEFILLAMA_API_KEY=
# DEFILLAMA_SWAP_API_BASE=https://api.llama.fi
# Keep Privy-managed deploy-session owners installed between deploys to reduce repeated add-owner prompts.
# Set to 0/false to force legacy cleanup behavior after each deploy session.
DEPLOY_SESSION_PERSIST_OWNER=true
# Deploy session + ERC-7712 permission TTL in minutes (clamped 5-240).
# Increase for slower mainnet deployments to avoid `erc7712_expired` mid-flight.
DEPLOY_SESSION_TTL_MINUTES=45
# Solana bridge-token auto-registration during deploy (server-only, optional):
# - signer key must be the current SolanaBridgeAdapter owner
# - mint bytes32 can be overridden per request body if needed
SOLANA_ADAPTER_OWNER_PRIVATE_KEY=
SOLANA_DEFAULT_MINT_BYTES32=
SOLANA_DEFAULT_MINT_DECIMALS=9
# Optional dynamic route provisioning (advanced):
# If enabled, server will run Base bridge CLI wrap-token when route is missing.
# IMPORTANT: on serverless runtimes (e.g. Vercel), local filesystem CLI paths are not available.
# In production, prefer SOLANA_DYNAMIC_ROUTE_PROVISIONER_URL and keep this runtime lightweight.
SOLANA_DYNAMIC_ROUTE_ENABLED=0
SOLANA_BRIDGE_CLI_DIR=
SOLANA_BRIDGE_CLI_BIN=auto
SOLANA_BRIDGE_DEPLOY_ENV=mainnet
SOLANA_BRIDGE_PAYER_KP=config
SOLANA_BRIDGE_SCALER_EXPONENT=9
# Dynamic Solana wrap metadata is strict Base-parity:
# - wraps use the exact Base token name/symbol (case preserved, including lowercase)
# - no transformed-symbol fallback is attempted
# - provisioning fails closed if exact metadata is incompatible with wrap-token constraints
# Deprecated/no-op in strict parity mode:
# SOLANA_BRIDGE_WRAP_NAME_PREFIX=CreatorShare
# SOLANA_BRIDGE_WRAP_SYMBOL_PREFIX=CS
# SOLANA_BRIDGE_WRAP_SYMBOL_MODE=auto
# Optional: include `--metadata-uri` when wrapping dynamic Solana mints.
# Keep disabled unless your installed bridge CLI supports this flag.
SOLANA_BRIDGE_WRAP_METADATA_URI_ENABLED=0
# Deprecated/no-op in strict parity mode:
# SOLANA_BRIDGE_WRAP_SYMBOL_SUFFIX=
SOLANA_BRIDGE_PAY_FOR_RELAY=1
# Optional remote dynamic provisioner (used when CLI isn't present in runtime, e.g. Vercel).
# Endpoint should return JSON with `mintBytes32` on success.
# If using `server/solana-provisioner`, set this to: https://<host>/provision
SOLANA_DYNAMIC_ROUTE_PROVISIONER_URL=
# Optional failover list (comma/space/newline separated). Tried in order.
# Example: "https://provisioner-a.4626.fun/provision,https://provisioner-b.4626.fun/provision"
SOLANA_DYNAMIC_ROUTE_PROVISIONER_URLS=
# Must match provisioner `PROVISIONER_BEARER_TOKEN`.
SOLANA_DYNAMIC_ROUTE_PROVISIONER_SECRET=
# Optional retries per provisioner endpoint for transient Solana RPC failures (e.g. "Blockhash not found").
# Set attempts >= 2 in production; delay is linear backoff per attempt.
SOLANA_DYNAMIC_ROUTE_PROVISIONER_RETRY_ATTEMPTS=3
SOLANA_DYNAMIC_ROUTE_PROVISIONER_RETRY_DELAY_MS=1200
# Optional per-attempt timeout when calling remote provisioner.
# 90s default helps avoid premature AbortError on slower wrap-token executions.
SOLANA_DYNAMIC_ROUTE_PROVISIONER_TIMEOUT_MS=90000
# Optional health endpoint for external checks and deploy infra dashboards.
# Example: https://<host>/healthz
SOLANA_DYNAMIC_ROUTE_PROVISIONER_HEALTH_URL=
# Optional health URL list matching URLS order (comma/space/newline separated).
SOLANA_DYNAMIC_ROUTE_PROVISIONER_HEALTH_URLS=
# Enforce SOL-only Meteora quote mint during deploy-session ix generation.
# Keep enabled in production to avoid helper-token fallback mappings.
SOLANA_STRICT_SOL_PAIR=1
# Canonical wrapped-asset policy for Solana route registration.
# - When allowlist is non-empty, only listed Base bridge tokens may be registered/provisioned.
# - When REQUIRED=1, empty allowlist is a hard blocker (fail-closed).
# Comma/space/newline separated list of Base token addresses.
SOLANA_CANONICAL_BRIDGE_TOKEN_ALLOWLIST=
SOLANA_CANONICAL_BRIDGE_TOKEN_ALLOWLIST_REQUIRED=0
# Optional dynamic-route liveness circuit breaker (remote provisioner mode).
# - When enabled, registration blocks if provisioner health is down or stale.
# - Requires SOLANA_DYNAMIC_ROUTE_PROVISIONER_HEALTH_URL (or derived /healthz path).
SOLANA_BRIDGE_LIVENESS_ENFORCED=0
SOLANA_BRIDGE_LIVENESS_MAX_HEALTH_AGE_SECONDS=180
# Meteora DLMM + Alpha Vault auto-deposit mapping (fail-closed for Solana-enabled finalizePhase2).
# This is the default Solana launch stack for 4626.
# Source priority:
# 1) DB table `creator_meteora_alpha_vaults` (creator_token -> config)
# 2) Env fallback map below
# JSON shape:
# {
#   "0xcreatorToken": {
#     "meteoraAlphaVault": "<base58 pubkey>",
#     "alphaVaultProgramId": "<base58 pubkey>",
#     "quoteMint": "So11111111111111111111111111111111111111112",
#     "depositAccounts": [
#       { "pubkey": "<base58 pubkey>", "isSigner": false, "isWritable": true }
#     ]
#   },
#   "default": { ...optional fallback config... }
# }
METEORA_CREATOR_ALPHA_VAULT_MAP_JSON=
# Optional dedicated provisioner endpoint(s) for Meteora ix payload building.
# When unset, backend derives these from SOLANA_DYNAMIC_ROUTE_PROVISIONER_URL[S] + `/meteora-ixs`.
METEORA_IX_PROVISIONER_URL=
METEORA_IX_PROVISIONER_URLS=
# Must match provisioner `PROVISIONER_BEARER_TOKEN`.
METEORA_IX_PROVISIONER_SECRET=
# Optional extra origins for session status auto-registration (useful with mixed Vercel + VM runtimes).
# Comma/space-separated absolute origins, e.g.:
# DEPLOY_SOLANA_REGISTRATION_ORIGINS=https://4626.fun,https://session.4626.fun
DEPLOY_SOLANA_REGISTRATION_ORIGINS=
# Optional machine-to-machine secret for /api/deploy/setupSolanaOvaultMesh.
# When set on both runtimes, session status will forward this secret as
# X-CV-Solana-Registration-Secret during cross-origin auto-registration calls.
# Keep this distinct from provisioner bearer auth unless you intentionally unify both.
DEPLOY_SOLANA_REGISTRATION_SECRET=
# Optional: if set, deploy/solanaInfraStatus will validate scalar(route) for this bridge token.
# Leave empty unless you intentionally pin a default bridge-token+mints route.
SOLANA_DEFAULT_BRIDGE_TOKEN=
#
# Solana operational -> canonical sweep pipeline (server-only, optional)
# - SIGNER key must be JSON secret-key array for the operational wallet
# - PROCESSOR_SECRET gates /api/wallet/solana/sweep/process
SOLANA_SWEEP_PROCESSOR_SECRET=
SOLANA_SWEEP_RPC_URL=
SOLANA_SWEEP_SIGNER_SECRET_KEY=
# Keep a small reserve so the operational wallet can pay fees for future retries.
SOLANA_SWEEP_RESERVE_LAMPORTS=5000
#
# ------------------------------------------------------------
# Postgres connection string for local dev (or any Node runtime).
# On Vercel, if you attach Vercel Postgres, `POSTGRES_URL` / `POSTGRES_URL_NON_POOLING`
# will be provided automatically.
DATABASE_URL=
# Optional pg pool tuning (important for serverless + Supabase Session mode).
# If you see `MaxClientsInSessionMode`, set POSTGRES_POOL_MAX=1 (or 2) in Vercel.
# POSTGRES_POOL_MAX=1
# TLS validation controls:
# - Default behavior is strict certificate validation.
# - If your provider uses a custom/self-signed chain, set
#   POSTGRES_SSL_REJECT_UNAUTHORIZED=false explicitly.
# POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# Keep this low on serverless/session mode so clients are released quickly.
# POSTGRES_POOL_IDLE_TIMEOUT_MS=1000
# POSTGRES_POOL_CONNECT_TIMEOUT_MS=5000
# POSTGRES_POOL_MAX_USES=7500
# Retry window after a failed init before attempting to re-open the pool.
# POSTGRES_INIT_RETRY_MS=10000
# Retry window specifically when Supabase session-mode pool saturation occurs.
# POSTGRES_INIT_RETRY_MS_MAX_CLIENTS=60000
CRON_SECRET=
# `/api/agent/process` defaults to strict unsupported-command retry mode.
# Unsupported commands are deferred (no fallback reply is sent and
# per-conversation checkpoint is not advanced past that message), so realtime
# runtime can retry them later without cron-mode command loss.
# Set to false to restore legacy fallback replies for unsupported commands.
# AGENT_PROCESS_STRICT_UNSUPPORTED_RETRY=true
# Creator metrics canonical sync tuning (server-only)
# - cadence is configured in vercel.json cron (`*/5 * * * *`)
# - tune chain scan + enrichment bounds for runtime limits
# CREATOR_METRICS_SYNC_PAGE_SIZE=20
# CREATOR_METRICS_SYNC_MAX_PAGES=120
# CREATOR_METRICS_CHAIN_SCAN_BLOCK_SPAN=90000
# CREATOR_METRICS_MAX_CHAIN_SCAN_CHUNKS=8
# CREATOR_METRICS_ENRICH_BATCH_SIZE=200
# CREATOR_METRICS_MIN_HISTORY_DAYS=90
#
# Coinbase Developer Platform (Server Wallets)
# Server-side credentials (do NOT prefix with VITE_).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
#
# Server-side RPC (used by Vercel Functions)
BASE_RPC_URL=
# Optional `/api/rpc` proxy throttles (server-only).
# Principal limit applies per authenticated wallet + chain.
# IP limit applies per source IP + chain and helps prevent key rotation abuse.
# RPC_PROXY_RATE_LIMIT_MAX_REQUESTS=120
# RPC_PROXY_RATE_LIMIT_MAX_REQUESTS_PER_IP=180
# Optional telemetry window logging for `/api/rpc`.
# RPC_PROXY_TELEMETRY=1
# RPC_PROXY_TELEMETRY_WINDOW_MS=30000
# Optional AMOE submit relayer key (server-only). `/api/v1/lottery/amoe/submit`
# resolves relay signer in this order:
#   1) LOTTERY_AMOE_RELAY_PRIVATE_KEY
#   2) KEEPR_PRIVATE_KEY (main keeper bot)
#   3) PRIVATE_KEY
# This makes the main keeper bot the default AMOE relayer when no explicit override is set.
LOTTERY_AMOE_RELAY_PRIVATE_KEY=
# Optional ERC-4337/CSW AMOE relay settings (server-only):
# - If LOTTERY_AMOE_RELAY_SMART_WALLET + *_BUNDLER_URL are set, AMOE relay prefers UserOp execution.
# - Privy path (no owner private key required): set *_PRIVY_WALLET_ID + *_OWNER.
# - Key path: set *_OWNER_PRIVATE_KEY (or CRE_ERC4337_OWNER_PRIVATE_KEY / KEEPR_PRIVATE_KEY fallback).
LOTTERY_AMOE_RELAY_SMART_WALLET=
LOTTERY_AMOE_RELAY_BUNDLER_URL=
LOTTERY_AMOE_RELAY_PRIVY_WALLET_ID=
LOTTERY_AMOE_RELAY_OWNER=
LOTTERY_AMOE_RELAY_OWNER_PRIVATE_KEY=

# Vercel Blob (server-only): required for durable token images
# - Used by `/api/v1/token/{address}/image` for caching upstream Zora images + rendered PNGs.
# - Configure in Vercel Project Settings → Environment Variables (Prod/Preview/Dev).
BLOB_READ_WRITE_TOKEN=

# Supabase Storage (server-only): used by `/admin/imagegen` project assets + outputs.
# - Requires a bucket accessible by the service role key.
# - Current admin preview flow expects this bucket to be public so `blob_url` renders directly.
SUPABASE_IMAGE_BUCKET=image-generation
#
# Optional allowlist for `/api/image/projects/auto-assets` source hosts.
# Comma/space separated hostnames; supports wildcard suffixes via `*.example.com`.
# Defaults include trusted Zora/IPFS/Arweave hosts.
IMAGE_AUTO_ASSET_ALLOWED_HOSTS=

# ------------------------------------------------------------
# Social profile enrichment (Vercel Functions)
# ------------------------------------------------------------
# These are server-only secrets (do NOT prefix with VITE_).
TWITTER_BEARER_TOKEN=
# Required for X/Twitter posting via `/x post` and `/tweet` commands (OAuth 1.0a user context).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TALENT_API_KEY=

# ------------------------------------------------------------
# IPFS
# ------------------------------------------------------------
# Public gateway used to resolve ipfs:// URIs in the browser.
# Default is Zora's Cloudflare-backed gateway: https://ipfs.decentralized-content.com/ipfs/
VITE_IPFS_GATEWAY=
#
# ------------------------------------------------------------
# ERC-8004 Agent Registration (server-only)
# ------------------------------------------------------------
# Identity Registry address on the target chain (e.g., Base mainnet).
ERC8004_AGENT_REGISTRY=
# Chain ID for the registry (e.g., 8453).
ERC8004_AGENT_CHAIN_ID=
# Agent ID (tokenId) from the registry.
ERC8004_AGENT_ID=
#
# Optional overrides for the registration file.
ERC8004_AGENT_NAME=
ERC8004_AGENT_DESCRIPTION=
ERC8004_AGENT_IMAGE_URL=
#
# Optional full JSON override for the registration file.
ERC8004_AGENT_REGISTRATION_JSON=
# Optional JSON array override for services (e.g., [{"name":"web","endpoint":"https://4626.fun"}]).
ERC8004_AGENT_SERVICES_JSON=
# Optional comma/space-separated list of supported trust models.
ERC8004_AGENT_SUPPORTED_TRUST=
# Optional explicit x402 support flag override (true/false).
# If unset, falls back to registration JSON/defaults.
# ERC8004_X402_SUPPORT=
#
# ERC-8004 Reputation Registry (feedback signals).
# Defaults to the canonical deployment: 0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ERC8004_REPUTATION_REGISTRY=
#
# ERC-8004 Validation Registry (validator request/response — spec evolving).
# No deterministic address published yet. Set when available.
ERC8004_VALIDATION_REGISTRY=
#
# Hard TEE attestation enforcement for privileged signing/actions.
# When enabled, privileged actions fail closed unless validation summary
# from ERC-8004 Validation Registry meets configured thresholds.
# TEE_ENFORCEMENT_ENABLED=true
# TEE_ENFORCEMENT_FAIL_OPEN=false
# TEE_VALIDATOR_ADDRESSES=0xValidatorAddress1,0xValidatorAddress2
# TEE_VALIDATION_TAG=tee-attestation
# TEE_MIN_VALIDATION_COUNT=1
# TEE_MIN_AVG_RESPONSE=1
# TEE_VALIDATION_CACHE_TTL_MS=30000
#
# ------------------------------------------------------------
# Optional data providers (Vercel Functions)
# ------------------------------------------------------------
# Talent Protocol (server-only) — used for builder score / socials enrichment
# Do NOT prefix with VITE_ (keep it off the client bundle).
# Get your API key from: https://docs.talentprotocol.com/docs/developers/talent-api/api-reference
# (already defined above under "Social profile enrichment")
#
# DeBank Cloud (server-only) — used for wallet portfolio totals (USD)
# Get your AccessKey from: https://cloud.debank.com/open-api
DEBANK_ACCESS_KEY=
#
# WalletLabels API key for entity labeling (free, register at https://walletlabels.xyz)
WALLET_LABELS_API_KEY=
#
# Etherscan v2 API key (multichain, used for funder tracing on Base + Ethereum)
# Get yours at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
#
# Optional: Ethereum mainnet RPC for ENS resolution (defaults to public endpoint)
# ETH_RPC_URL=

# ------------------------------------------------------------
# Invite-only launch gate (Vercel Functions)
# ------------------------------------------------------------
# Used to sign SIWE session cookies in serverless.
# In development, a random in-memory secret is used if this is unset,
# but in production you should set a stable secret (16+ chars).
AUTH_SESSION_SECRET=

# Comma/space-separated list of admin wallet addresses allowed to approve/deny requests.
CREATOR_ACCESS_ADMIN_ADDRESSES=

# Comma/space-separated list of admin emails allowed to approve/deny requests.
# The system looks up the email from users or creator_wallets based on the signed-in wallet.
CREATOR_ACCESS_ADMIN_EMAILS=

# Legacy fallback (no DB): comma/space-separated list of approved creator wallet addresses.
# If empty AND no DB is configured, the allowlist is disabled (everyone can proceed).
CREATOR_ALLOWLIST=



# ------------------------------------------------------------
# XMTP Agent (server-only)
# ------------------------------------------------------------
# Three startup modes (checked in priority order):
#
# 1. Multi-agent mode: load agents from DB, decrypt keys, run orchestrator.
#    Requires DATABASE_URL + XMTP_AGENT_KEY_ENCRYPTION_KEY.
XMTP_AGENT_KEY_ENCRYPTION_KEY=
#
# 2. Single-agent CSW mode (recommended): Privy server wallet signs on
#    behalf of your Coinbase Smart Wallet. Same delegation pattern used
#    for ERC-4337 UserOps and vault deployments. No private key extraction.
#    Requires PRIVY_APP_ID, PRIVY_APP_SECRET, PRIVY_WALLET_AUTHORIZATION_KEY,
#    PRIVY_WALLET_OWNER_ID to be set (see Privy section above).
XMTP_AGENT_CSW_ADDRESS=
XMTP_AGENT_PRIVY_WALLET_ID=
# XMTP_AGENT_CSW_CHAIN_ID=8453
# Optional owner index hint of the Privy wallet in the CSW's MultiOwnable owner list.
# Runtime now validates this and auto-discovers the correct index when mismatched.
# You can still set it to speed startup if known.
# XMTP_AGENT_CSW_OWNER_INDEX=0
#
# 3. Single-agent EOA mode (dev/testing): raw hex private key.
XMTP_AGENT_PRIVATE_KEY=
#
# XMTP network: 'production' | 'dev' (default: production)
XMTP_ENV=production
#
# Runtime role/failover controls
# - primary: active consumer (connects to XMTP)
# - standby: passive instance for local inspection only (not the normal Railway deploy)
AGENT_RUNTIME_ROLE=primary
AGENT_CONSUME_XMTP=true
# Production-primary XMTP boots are intended to run on Railway.
# Railway startup fails if AGENT_RUNTIME_ROLE!=primary or AGENT_CONSUME_XMTP=false.
# Off-Railway primary boots are blocked by default unless you explicitly opt in.
# ELIZA_ALLOW_OFF_RAILWAY_PRIMARY=false
# Swarm-v1 role mapping (optional): deterministic specialist roles by agent key.
# Keys are `creatorAddress` in multi-agent mode, or `single-agent` / `single-agent-csw`.
ELIZA_SWARM_ROLE_MAP_JSON={"single-agent-csw":"general","0xab6d5c10b03300326cd7fab7267ae192842967b5":"general"}
# Example specialist override:
# ELIZA_SWARM_ROLE_MAP_JSON={"single-agent-csw":"general","0xab6d5c10b03300326cd7fab7267ae192842967b5":"general","0xabc...":"trader","0xdef...":"social"}
# 3-agent preset template (general + trader + social):
# ELIZA_SWARM_ROLE_MAP_JSON={"single-agent-csw":"general","0x1111111111111111111111111111111111111111":"general","0x2222222222222222222222222222222222222222":"trader","0x3333333333333333333333333333333333333333":"social"}
# Optional role capability overrides
# ELIZA_SWARM_CAPABILITIES_JSON={"trader":["uniswap","zora","cre"],"social":["lens"],"knowledge":["knowledge","reputation","wallet"]}
#
# DB-backed runtime lease lock.
# On Railway primary with Postgres configured, this defaults to true and should stay enabled.
# Explicitly forcing it false on Railway primary is rejected at startup.
# AGENT_RUNTIME_LOCK_REQUIRED=true
# AGENT_RUNTIME_LOCK_KEY=xmtp-primary-runtime-lock
# AGENT_RUNTIME_LOCK_HEARTBEAT_MS=10000
# AGENT_RUNTIME_LOCK_STALE_MS=30000
#
# Encryption key for the XMTP local database (0x-prefixed hex, 32 bytes).
# Required so persisted .db3 files can be reopened across restarts.
# Generate with: openssl rand -hex 32  (then prefix with 0x)
XMTP_DB_ENCRYPTION_KEY=
# Optional Grove archive encryption seed for cold-memory bundles.
# Accepts 32-byte hex (0x...), base64, or passphrase.
# ELIZA_GROVE_ARCHIVE_ENCRYPTION_KEY=
# Enable encrypted cold-memory archiving to Grove.
# ELIZA_GROVE_ARCHIVE_ENABLED=false
# Archive cadence controls (turn threshold + minimum minutes between archives).
# ELIZA_GROVE_ARCHIVE_TURN_THRESHOLD=200
# ELIZA_GROVE_ARCHIVE_INTERVAL_MINUTES=60
# Max Grove chunks to pull during cold-history restore.
# ELIZA_GROVE_RECALL_MAX_CHUNKS=5
#
# Directory to persist XMTP local databases (default: <cwd>/.xmtp-data/).
# Setting this ensures the SDK reuses the same installation across restarts
# instead of creating a new one each time (avoids hitting the 10-installation limit).
# XMTP_DB_DIRECTORY=
# Enforce runtime persistence/encryption policies (recommended true in production primary runtime)
# XMTP_REQUIRE_PERSISTENT_DB=true
# XMTP_REQUIRE_DB_ENCRYPTION=true
# Force plaintext XMTP DB mode for runtimes without SQLCipher support.
# When true, runtime ignores XMTP_DB_ENCRYPTION_KEY and opens DB unencrypted.
# XMTP_DB_PLAINTEXT_ONLY=false
#
# One-time migration: rotate legacy PLAINTEXT .db3(s) aside so the Agent SDK can
# create a fresh ENCRYPTED DB (using XMTP_DB_ENCRYPTION_KEY).
# This WILL register 1 new installation for the same inbox (consumes 1 inbox update).
# To prevent accidental churn, migration is gated behind an explicit confirmation.
#
# Railway runbook:
# 1) Set a persistent key ONCE:
#    XMTP_DB_ENCRYPTION_KEY=0x$(openssl rand -hex 32)
# 2) Run a single migration deploy:
#    XMTP_DB_FORCE_ENCRYPTED_MIGRATION=1
#    XMTP_DB_FORCE_ENCRYPTED_MIGRATION_CONFIRM=rotate-db
# 3) After a clean boot, UNSET the FORCE vars (keep XMTP_DB_ENCRYPTION_KEY).
# XMTP_DB_FORCE_ENCRYPTED_MIGRATION=false
# XMTP_DB_FORCE_ENCRYPTED_MIGRATION_CONFIRM=
#
# Revoke all other installations on startup (default: false).
# Only set to 'true' when recovering from the 10/10 installation limit.
# WARNING: Every revocation burns an inbox update (256 lifetime max).
# If the DB is ephemeral (no volume), this creates + revokes on every restart.
# See: https://docs.xmtp.org/agents/build-agents/local-database
XMTP_REVOKE_OTHER_INSTALLATIONS=false
#
# Agent XMTP address (CSW) — frontend auto-starts a DM with this address on connect
VITE_AGENT_XMTP_ADDRESS=
# Optional server-side directory listing fallback for /api/agents
# XMTP_AGENT_ADDRESS=
#
# LLM provider for conversational AI (pick one):
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
#
# Image generation workflow (Responses API + image_generation tool)
# OPENAI_API_KEY=
# OPENAI_RESPONSES_MODEL=gpt-5.4
#
# Agent runtime hardening controls
# --------------------------------
# Optional telemetry hooks (structured logs + webhook sink)
# ELIZA_TELEMETRY_ENABLED=false
# ELIZA_TELEMETRY_WEBHOOK_URL=
# ELIZA_TELEMETRY_SAMPLE_RATE=1
# ELIZA_TELEMETRY_TIMEOUT_MS=1500
#
# Feature-flagged channel context plugins (ingress handled separately)
# ELIZA_CHANNEL_TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# Telegram login checklist:
# - Set bot allowed domain via @BotFather /setdomain (must match frontend origin used for auth).
# - Telegram auth does not support .xyz TLDs.
# - In Privy Dashboard allowed domains, include:
#   https://4626.fun, https://app.4626.fun, http://web.telegram.org, https://web.telegram.org
# Optional Telegram webhook hardening and chat routing:
# TELEGRAM_WEBHOOK_SECRET=          # match X-Telegram-Bot-Api-Secret-Token
# TELEGRAM_TARGET_CHAT_ID=          # if set, ignores updates from other chats
# TELEGRAM_ADMIN_USER_IDS=          # comma-separated Telegram user IDs allowed for privileged /x posts
# TELEGRAM_BOT_CONFIG_SECRET=       # optional secret for POST /api/telegram/bot-config (falls back to TELEGRAM_LINK_API_SECRET)
# TELEGRAM_DEFAULT_SENDER_WALLET=   # fallback wallet for Keepr command context
# TELEGRAM_USER_WALLET_MAP_JSON={"123456":"0xabc..."}   # optional per-user wallet mapping
# TELEGRAM_DEFAULT_GROUP_ID=        # fallback Keepr group id for command routing
# TELEGRAM_GROUP_ID_MAP_JSON={"-1003792889924":"<keepr-group-id>"} # per-chat group mapping
# TELEGRAM_MENU_BUTTON_MODE=commands # commands (default) or web_app
# TELEGRAM_MENU_BUTTON_TEXT=Connect # used only when TELEGRAM_MENU_BUTTON_MODE=web_app
# TELEGRAM_COPY_TEXT_BUTTONS=true   # use Telegram copy_text buttons on signal reuse shortcuts
# TELEGRAM_REQUIRE_TRADE_MEMBERSHIP=false # require getChatMember pass for /buy /sell /bid in groups
# TELEGRAM_TRADE_USER_RATE_LIMIT_PER_MIN=10
# TELEGRAM_TRADE_CHAT_RATE_LIMIT_PER_MIN=60
# TELEGRAM_BID_USER_RATE_LIMIT_PER_MIN=3
# TELEGRAM_BID_CHAT_RATE_LIMIT_PER_MIN=20
# TELEGRAM_LINK_TOKEN_SECRET=       # optional HMAC secret for one-time Telegram link tokens
# TELEGRAM_LINK_API_SECRET=         # optional shared secret for server-to-server Telegram endpoints (e.g. unlink/portfolio/bot-config)
# TELEGRAM_BASE_APP_INVITE_URL=https://base.app/invite/4626/T9Y9BZYK  # shown as "Get Base app" during Telegram create-new CSW onboarding
# Optional: Privy Global Wallets (cross-app linking) — see https://docs.privy.io/wallets/global-wallets/overview
# TELEGRAM_MINIAPP_SESSION_ENABLED=true # require Telegram WebApp initData verification + server session for Mini App flows
# TELEGRAM_MINIAPP_SESSION_CHAT_IDS=    # optional comma-separated chat rollout cohort for Mini App sessions
# TELEGRAM_MINIAPP_SESSION_USER_IDS=    # optional comma-separated Telegram user rollout cohort for Mini App sessions
# TELEGRAM_MINIAPP_INITDATA_MAX_AGE_SECONDS=900 # max age for Telegram initData auth_date
# TELEGRAM_MINIAPP_SESSION_TTL_SECONDS=600       # server session TTL for Mini App API calls
# TELEGRAM_MINIAPP_REPLAY_TTL_SECONDS=900        # replay nonce TTL for initData hashes
# TELEGRAM_FUNNEL_EVENTS_ENABLED=true # emit link/trade funnel events into telegram_funnel_events
# TELEGRAM_FUNNEL_EVENTS_CHAT_IDS=   # optional comma-separated chat cohort for funnel event rollout
# TELEGRAM_FUNNEL_METRICS_ENABLED=false # enable GET /api/telegram/metrics endpoint
# TELEGRAM_FUNNEL_METRICS_CHAT_IDS=  # optional metrics cohort (falls back to TELEGRAM_FUNNEL_EVENTS_CHAT_IDS)
# TELEGRAM_WAITLIST_VERIFY_CHAT_ID= # optional group/channel id for waitlist social telegram verification
# TELEGRAM_ETH_USD=3000             # fallback ETH/USD used for /buy and /bid preview estimates
# TELEGRAM_SHARE_USD_FALLBACK=1     # fallback SHARE/USD used for /sell preview estimates
# TELEGRAM_SIGNALS_CHAT_ID=         # optional destination chat for signal follow-up posts (defaults to source chat)
# TELEGRAM_SIGNALS_THREAD_ID=       # optional Telegram topic/thread id for Signals posts (forum topics)
# TELEGRAM_SIGNALS_THREAD_BY_CHAT_JSON={"-100123":777} # optional per-chat topic mapping
# ELIZA_CHANNEL_DISCORD_ENABLED=false
# DISCORD_BOT_TOKEN=
# ELIZA_CHANNEL_TWITTER_ENABLED=false
# TWITTER_BEARER_TOKEN=   # reuse token from social section above
#
# Request timeout per provider call (ms)
ELIZA_LLM_TIMEOUT_MS=30000
# Retry attempts for transient upstream failures (429/5xx/network)
ELIZA_LLM_MAX_RETRIES=3
# Initial retry delay in ms (exponential backoff)
ELIZA_LLM_RETRY_BASE_MS=1000
# Provider circuit breaker opens after N consecutive failures
ELIZA_PROVIDER_CIRCUIT_FAILS=3
# Circuit open duration (ms) before retrying provider
ELIZA_PROVIDER_CIRCUIT_OPEN_MS=60000
# Grove upload behavior:
# - on-change (default): upload only when registration payload hash changes
# - always: upload every startup
# - off: skip startup upload
# ELIZA_GROVE_UPLOAD_MODE=on-change
# Off-Railway Grove uploads are disabled by default to avoid local mutation.
# ELIZA_ALLOW_OFF_RAILWAY_GROVE_UPLOAD=false
# Registration publishing pipeline:
# - mutable: update/create via dedicated publisher signer
# - immutable: always content-addressed snapshot uploads
# Default auto-selects mutable when GROVE_PUBLISHER_PRIVATE_KEY is set.
# GROVE_REGISTRATION_PIPELINE=mutable
# Dedicated Grove publisher signer for mutable registration updates.
# Keep this key server-side only.
# GROVE_PUBLISHER_PRIVATE_KEY=
# Optional ACL type for mutable content: wallet (default) or lensAccount
# GROVE_PUBLISHER_ACL_TYPE=wallet
# Optional ACL owner address (defaults to address derived from private key)
# GROVE_PUBLISHER_ADDRESS=
# Optional ACL chain id (defaults to GROVE_CHAIN_ID/Lens mainnet)
# GROVE_PUBLISHER_CHAIN_ID=232
# Optional provider priority order (comma-separated names)
# ELIZA_LLM_PROVIDER_PRIORITY=Groq,OpenAI,Anthropic,OpenRouter
# Optional complex-intent routing order (used for DeFi/analysis prompts)
# ELIZA_LLM_COMPLEX_PROVIDER_PRIORITY=Anthropic,OpenAI,Groq,OpenRouter
# Minimum message length considered complex for routing (chars)
# ELIZA_LLM_COMPLEX_INPUT_CHARS=700
# Enable/disable intent-aware provider routing
# ELIZA_LLM_INTENT_ROUTING=true
# Optional per-provider model overrides
# ELIZA_GROQ_MODEL=llama-3.3-70b-versatile
# ELIZA_OPENAI_MODEL=gpt-4o-mini
# ELIZA_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ELIZA_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Input guardrails
ELIZA_LLM_MAX_INPUT_CHARS=4000
ELIZA_LLM_MAX_OUTPUT_TOKENS=512
# Daily budget guardrails (leave blank to disable)
# ELIZA_DAILY_LLM_TOKEN_BUDGET=200000
# ELIZA_DAILY_LLM_USD_BUDGET=10
# Message rate limiting (per conversation + sender)
ELIZA_RATE_LIMIT_WINDOW_MS=60000
ELIZA_RATE_LIMIT_MAX_MESSAGES=12
# Hard cap for inbound message length (chars)
ELIZA_MAX_INBOUND_CHARS=4000
# Action orchestration guardrail: number of ranked candidates to try
ELIZA_ACTION_MAX_CANDIDATES=2
# Retries for transient action execution failures
ELIZA_ACTION_MAX_RETRIES=2
# Generic retries/backoff for external dependencies (context providers, startup deps)
ELIZA_EXTERNAL_MAX_RETRIES=2
ELIZA_EXTERNAL_RETRY_BASE_MS=750
# Startup DB readiness retries (multi-agent mode)
ELIZA_STARTUP_DB_MAX_RETRIES=4
ELIZA_STARTUP_DB_RETRY_BASE_MS=1000
# XMTP SDK start retries
ELIZA_XMTP_START_MAX_RETRIES=3
ELIZA_XMTP_START_RETRY_BASE_MS=1000
# Optional character runtime overrides
# ELIZA_CHARACTER_MODEL=gpt-4o-mini
# ELIZA_CHARACTER_SYSTEM_PROMPT=
# ELIZA_CHARACTER_TEMPERATURE=0.7
# ELIZA_CHARACTER_MAX_OUTPUT_TOKENS=512
# Optional additional knowledge docs (comma or newline-separated repo-relative paths)
# ELIZA_KNOWLEDGE_DOC_PATHS=docs/protocol.md,docs/runbook.md
# Background queue worker settings
ELIZA_TASK_WORKER_POLL_MS=3000
ELIZA_TASK_WORKER_MAX_TASKS=5
ELIZA_TASK_RETRY_BASE_MS=2000
ELIZA_TASK_RETRY_MAX_MS=60000
# Reclaim processing tasks whose lease is stale (milliseconds)
ELIZA_TASK_LEASE_STALE_MS=300000
# Bound welcome-message tracking memory (TTL + max tracked conversations)
ELIZA_WELCOME_TRACK_TTL_MS=86400000
ELIZA_WELCOME_TRACK_MAX=20000

# ------------------------------------------------------------
# Premium token icon breakout tuning (server-side)
# ------------------------------------------------------------
# Extra pixel offset to move illustration top-breakout lower.
# Applies globally to all creator renders that use illustration breakout logic.
# Default in code: 1
# TOKEN_PREMIUM_ILLUSTRATION_BREAKOUT_EXTRA_DOWN_PX=1
