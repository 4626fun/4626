{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src",
    "api",
    "server"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "./tsconfig.docs.json",
  "out": "../docs/_generated/frontend",
  "plugin": ["typedoc-plugin-markdown"],
  "outputFileStrategy": "modules",
  "flattenOutputFiles": false,
  "entryFileName": "index",
  "readme": "none",
  "intentionallyNotExported": [
    "AccountContextValue",
    "AddressLike",
    "AgentVerifyResponse",
    "ApiHandlerModule",
    "ArtworkFitMode",
    "BreakoutSourceKind",
    "CanonicalizationParams",
    "CreatorTokenArtwork",
    "CrossAppFn",
    "DbWithSql",
    "DeploySessionRecord",
    "Eip1193ProviderLike",
    "EnsureTelegramMiniAppSessionResult",
    "EnvLike",
    "EthereumProviderCollisionState",
    "FallbackCommandResult",
    "ImmediateToastInput",
    "JobStatus",
    "LoopbackOriginResolutionInput",
    "OnboardingBootstrapResponse",
    "Permit2TokenPermissions",
    "PremiumLayout",
    "PrivyClientStatus",
    "ProjectStatus",
    "RenderPreset",
    "ResolveModePreferredIdentityInput",
    "ResolveModePreferredIdentityResult",
    "SolanaOvaultRequest",
    "SourceClass",
    "SwitchChainAsyncLike",
    "TelegramWebAppLike",
    "ThemeState",
    "TokenIconLayout",
    "TokenIconRecipe",
    "UserOpSignMode",
    "WalletLike",
    "XmtpContextValue",
    "ZoraHandoffContext"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "src/main.tsx",
    "src/vite-env.d.ts",
    "**/*.generated.ts",
    "src/config/contracts.defaults.ts"
  ],
  "blockTags": [
    "@defaultValue",
    "@default",
    "@deprecated",
    "@description",
    "@example",
    "@param",
    "@privateRemarks",
    "@remarks",
    "@returns",
    "@see",
    "@throws",
    "@typeParam"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "disableSources": false,
  "githubPages": false,
  "hideGenerator": true,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  }
}
