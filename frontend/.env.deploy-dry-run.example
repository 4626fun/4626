# Local deploy dry-run preset
#
# Copy to `.env.deploy-dry-run.local` if you want a private local variant.
# The shell runner will load `.env.deploy-dry-run.local` first when present,
# otherwise it falls back to this example file.

# Real upstream Base mainnet RPC used by Anvil for forking.
BASE_FORK_UPSTREAM_RPC_URL=

# Local Anvil fork bind settings.
DEPLOY_DRY_RUN_FORK_HOST=127.0.0.1
DEPLOY_DRY_RUN_FORK_PORT=8545
DEPLOY_DRY_RUN_FORK_CHAIN_ID=8453
# Use a fork-only deployment namespace so deterministic CREATE2 addresses do
# not collide with live Base deployments while testing on a mainnet fork.
VITE_DEPLOYMENT_VERSION=v1.9.2-dryrun
# Optional override for initial deploy reserve (whole tokens).
# Keep this at 50000000 to match the enforced 50M-token deployment policy.
VITE_MIN_FIRST_DEPOSIT_TOKENS=50000000

# Default: use canonical batcher from env/defaults so dry-run mirrors production behavior.
# Set to 1 only when you explicitly want to test a freshly deployed local batcher contract.
DEPLOY_DRY_RUN_USE_LOCAL_BATCHER=0
# Optional: mirror constructor args from a different source batcher.
# DEPLOY_DRY_RUN_SOURCE_BATCHER=0xb2481e6F970B92Cd6435Ed9e19956e2F2D3C1753
# Optional: private key used to deploy the local batcher (defaults to Anvil account #0).
# DEPLOY_DRY_RUN_DEPLOYER_PRIVATE_KEY=

# Dev server port (default 5174 to avoid conflict with regular pnpm dev on 5173).
# DEPLOY_DRY_RUN_PORT=5174

# Canonical origin for dry-run dev (required for API handlers).
APP_ORIGIN=http://localhost:5174
# Client bundle: use localhost so redirects stay local (not app.4626.fun).
VITE_APP_ORIGIN=http://localhost:5174
# Treat localhost as app (avoid redirect to app.4626.fun).
VITE_HOST_MODE_OVERRIDE=app
# Enable Privy auth for deploy (required for deploy page).
VITE_PRIVY_ENABLED=true
# Allow Privy only on the supported dry-run dev ports.
VITE_PRIVY_ALLOWED_ORIGINS="http://localhost:5173 http://localhost:5174 http://127.0.0.1:5173 http://127.0.0.1:5174"

# The shell runner exports these for the frontend + API process tree so
# `/deploy` dry-run reads and browser-side reads both hit the local fork.
# The Deploy page only shows `Run dry-run` when VITE_BASE_RPC points to localhost/127.0.0.1.
BASE_RPC_URL=http://127.0.0.1:8545
VITE_BASE_RPC=http://127.0.0.1:8545

# Use repo defaults on the fork; do not inherit stale local contract overrides.
VITE_ALLOW_CONTRACT_OVERRIDES=0
ALLOW_API_CONTRACT_OVERRIDES=0

# FIX: FINDING-18 — DEPLOY_DRY_RUN_DEV_BYPASS removed from committed example.
# See internal runbooks for local unauthenticated dry-run configuration.
