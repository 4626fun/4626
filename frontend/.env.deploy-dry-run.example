# Deploy dry-run preset (shared fallback).
# Use `.env.deploy-dry-run.local` for machine-private overrides.

# Required: upstream Base RPC used by Anvil for forking.
BASE_FORK_UPSTREAM_RPC_URL=https://eu.endpoints.matrixed.link/rpc/base?auth=p886of4gitu82

# Keep local dry-run deterministic addresses isolated from live deploys.
VITE_DEPLOYMENT_VERSION=v1.11.0-dryrun
VITE_MIN_FIRST_DEPOSIT_TOKENS=50000000

# Default to canonical deploy behavior; opt into local batcher only when needed.
DEPLOY_DRY_RUN_USE_LOCAL_BATCHER=0

# Dry-run app/auth safety defaults.
DEPLOY_DRY_RUN_PORT=5174
# Keep port deterministic by default (set to 1 to allow 5173/5174 fallback).
DEPLOY_DRY_RUN_ALLOW_PORT_FALLBACK=0
APP_ORIGIN=http://localhost:5174
VITE_APP_ORIGIN=http://localhost:5174
VITE_HOST_MODE_OVERRIDE=app
VITE_PRIVY_ENABLED=true
VITE_PRIVY_ALLOWED_ORIGINS="http://localhost:5174 http://127.0.0.1:5174"

# Keep contract resolution pinned to repo defaults.
VITE_ALLOW_CONTRACT_OVERRIDES=0
ALLOW_API_CONTRACT_OVERRIDES=0
