{
  "name": "@4626/cre-workflows",
  "version": "1.0.0",
  "description": "CRE automation workflows for 4626 protocol",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx runner.ts",
    "start:vault-keeper": "tsx runner.ts vault-keeper",
    "start:auction-settlement": "tsx runner.ts auction-settlement",
    "start:keepr-queue": "tsx runner.ts keepr-queue",
    "dry-run": "DRY_RUN=true tsx runner.ts",
    "dry-run:vault-keeper": "DRY_RUN=true tsx runner.ts vault-keeper",
    "dry-run:auction-settlement": "DRY_RUN=true tsx runner.ts auction-settlement",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
