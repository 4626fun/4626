# ============================================================================
# CRE Secrets — 4626 Automation Workflows
# ============================================================================
# Copy to .env for local testing. NEVER commit actual values.
# ============================================================================

# ---------------------------------------------------------------------------
# Keeper wallet (used by all onchain-write workflows)
# ---------------------------------------------------------------------------
# Must be set as vault keeper via setKeeper(), and authorized as
# isPriceUpdater on the oracle.
KEEPR_PRIVATE_KEY=0x_YOUR_KEEPR_PRIVATE_KEY_HERE

# ---------------------------------------------------------------------------
# RPC
# ---------------------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org

# ---------------------------------------------------------------------------
# Multi-vault mode (recommended)
# ---------------------------------------------------------------------------
# When set, workflows will fetch all registered vaults from the API.
# This is the recommended setup for managing multiple vaults.
KEEPR_API_BASE_URL=https://4626.fun/api
KEEPR_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Single-vault mode (optional, for backwards compatibility)
# ---------------------------------------------------------------------------
# If these are set, workflows will use them instead of fetching from the API.
# Leave unset to use multi-vault mode.
#
# VAULT_ADDRESS=0x_VAULT_ADDRESS
# CREATOR_COIN_ADDRESS=0x_CREATOR_COIN_ADDRESS
# ORACLE_ADDRESS=0x_ORACLE_ADDRESS
# VRF_HUB_ADDRESS=0x_VRF_HUB_ADDRESS
# CCA_STRATEGY_ADDRESS=0x_CCA_STRATEGY_ADDRESS

# ---------------------------------------------------------------------------
# Cross-chain broadcast targets (comma-separated LayerZero EIDs)
# ---------------------------------------------------------------------------
BROADCAST_DST_EIDS=30110,30111

# ---------------------------------------------------------------------------
# VRF spoke addresses (comma-separated chain:address pairs)
# Example: 30110:0xABC...,30111:0xDEF...
# ---------------------------------------------------------------------------
VRF_SPOKE_ADDRESSES=

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
