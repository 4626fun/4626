{
  "schedule": "0 */1 * * * *",
  "apiBaseUrl": "https://4626.fun/api",
  "workflowName": "runtime-orchestrator",
  "blockSourceWorkflow": "runtime-indexer-block",
  "checkpointIntervalSeconds": 120,
  "minMatchedTransactionsForAction": 1,
  "sinkEnabled": true,
  "kvDisabled": false,
  "initialCheckpoint": 0,
  "aws_region": "us-east-1",
  "s3_bucket": "your-staging-runtime-checkpoints",
  "s3_key": "runtime-orchestrator/checkpoint.txt",
  "aws_role_arn": "arn:aws:iam::REPLACE_ACCOUNT_ID:role/cre-runtime-orchestrator-staging",
  "aws_role_session_name": "cre-runtime-orchestrator",
  "aws_session_duration_seconds": 900,
  "s3_bucket_allowlist": ["your-staging-runtime-checkpoints"],
  "s3_key_prefix_allowlist": ["runtime-orchestrator/"]
}
