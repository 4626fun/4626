# =============================================================================
# 1659 Theatrical Marketing Stack — Complete Environment Variables
# =============================================================================
#
# This is the SINGLE SOURCE OF TRUTH for the full 1659 hype machine:
#   - Hermit creative agent (hermit.4626.fun) → rich /gmeow /hermit replies in room 1659
#   - 1659 Risk Watcher → automatic alerts to private ops relay + public @fun4626
#
# Both systems share the same core requirements for the rich 1659 context:
#   Hyperliquid position + on-chain FriendKey quadratic curve + AlfaClub PnL.
#
# =============================================================================
# QUICKEST WAY TO VERIFY EVERYTHING
# =============================================================================
#
# Run this command (with your real env):
#   env $(cat 1659-theatrical-stack.env | xargs) pnpm 1659:doctor
#
# It will tell you exactly what is missing and give you clean copy-paste
# blocks for Railway.
#
# =============================================================================
# HOW TO USE THIS FILE
# =============================================================================
#
# 1. Copy this file and fill in real values.
# 2. For the dedicated Hermit Railway service:
#      Paste into Railway Variables (or use railway CLI).
# 3. For local testing:
#      env $(cat 1659-theatrical-stack.env | xargs) pnpm ops:1659-watch
# 4. For the risk watcher on Railway: same file works (it only needs a subset).
#
# IMPORTANT: The Hermit service and watcher can (and usually should) share
# the same env values.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (REQUIRED for both Hermit and rich watcher context)
# -----------------------------------------------------------------------------
# The alfaclub token stores, chat JWT persistence, and schema bootstrap are
# pulled in at import time for the chat bridge and 1659 context.
# Use the Supabase transaction pooler (port 6543) for serverless/Railway.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Legacy / generic Postgres fallback (Supabase via DATABASE_URL is strongly preferred)
# POSTGRES_URL=...

# -----------------------------------------------------------------------------
# 2. ALFACLUB AUTH (REQUIRED for authenticated PnL + bridge)
# -----------------------------------------------------------------------------
# The rich 1659 context (spot + PnL history) and the AlfaClub chat bridge
# both need a valid identity token.

# Preferred for long-lived Railway services: provide the Privy refresh triplet.
# The refresher will keep ALFACLUB_CHAT_JWT fresh automatically.
ALFACLUB_CHAT_PRIVY_ACCESS_TOKEN=
ALFACLUB_CHAT_PRIVY_REFRESH_TOKEN=

# Alternative / fallback: a fresh short-lived JWT (you can paste this from
# browser devtools when logged into AlfaClub as the bot user).
ALFACLUB_CHAT_JWT=

# Optional but recommended (the code already defaults to the correct value)
ALFACLUB_PRIVY_APP_ID=cmk2k53f101jkl70cw44uib7x
ALFACLUB_PRIVY_ORIGIN=https://alfaclub.app

# For the dedicated Hermit service (hermit.4626.fun) only:
# Enable the in-process refresher so this service owns dynamic token rotation.
# Leave this unset on other Railway services.
ALFACLUB_CHAT_PRIVY_REFRESHER_ENABLED=1

# -----------------------------------------------------------------------------
# 3. PINATA OPENCLAW (Strongly recommended for Hermit creative quality)
# -----------------------------------------------------------------------------
# Without these, /hermit /gmeow /meme in room 1659 will still work but will
# lack the rich live market context injection.
HERMIT_PINATA_CHAT_ENDPOINT=
HERMIT_PINATA_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# 4. ROOM TARGETING (Critical for 1659 theatrical behavior)
# -----------------------------------------------------------------------------
# Tell the system which room(s) should get the special 1659 treatment
# (live Hyperliquid + on-chain curve + hype scoring injected into prompts).
ALFACLUB_HERMIT_COMMAND_ROOMS=1659
# Legacy single-room form also works:
# ALFACLUB_CHAT_ROOM_ID=1659

# -----------------------------------------------------------------------------
# 5. TELEGRAM (Required for the 1659 Risk Watcher alerts)
# -----------------------------------------------------------------------------
# These are the same vars you already use for AlfaClub relay / radar.
# The watcher reuses them so you don't need new bot tokens.

# Bot token (the one with permission to post in your channels)
ALFACLUB_TELEGRAM_BOT_TOKEN=
# Fallback (if you use a different bot for some flows)
# TELEGRAM_BOT_TOKEN=

# Private ops relay (detailed alerts, liquidation distance, ROE, etc.)
ALFACLUB_TELEGRAM_RELAY_CHAT_ID=-1003709479662
ALFACLUB_TELEGRAM_RELAY_THREAD_ID=2
# Alternative names also accepted:
# TELEGRAM_TARGET_CHAT_ID=-1003709479662

# Public community channel (theatrical copy for everyone)
ALFACLUB_RADAR_TELEGRAM_CHAT_ID=@fun4626
# Alternative names also accepted:
# FUN4626_TELEGRAM_CHAT_ID=@fun4626
# TARGET_CHAT_ID=...

# -----------------------------------------------------------------------------
# 6. ON-CHAIN + HYPERLIQUID (Optional overrides — good defaults exist)
# -----------------------------------------------------------------------------
# Base RPC (used for FriendKey on-chain reads)
BASE_RPC_URL=https://mainnet.base.org

# Explicit 1659 FriendKey contract + tokenId (these are already the correct defaults)
ROOM_1659_FRIENDKEY_TOKEN=0xAF0Bf8593dC6CA973DF2132731B0F9B5F974FA9F
ROOM_1659_FRIENDKEY_ID=1659

# Hyperliquid info endpoint override (rarely needed)
# HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info

# -----------------------------------------------------------------------------
# 7. OPTIONAL / ADVANCED
# -----------------------------------------------------------------------------
# PORT is set automatically by Railway / most platforms.
# Only set this if running locally and you want a specific port.
# PORT=8080

# How often the watcher polls (default is aggressive — you usually don't need to change)
# 1659_RISK_MONITOR_INTERVAL_MIN=1

# AlfaClub chat bridge tuning (only relevant if ALFACLUB_CHAT_BRIDGE_ENABLED=1 on Hermit)
# ALFACLUB_CHAT_BRIDGE_ENABLED=true
# ALFACLUB_CHAT_POLL_INTERVAL_MS=6000
# ALFACLUB_CHAT_HISTORY_LIMIT=20

# -----------------------------------------------------------------------------
# NOTES FOR RAILWAY
# -----------------------------------------------------------------------------
# - For the dedicated Hermit service (hermit.4626.fun):
#     You need almost everything above (especially DATABASE_URL + AlfaClub auth + Pinata).
#
# - For a separate 1659-risk-watcher Railway service (if you run one):
#     You mainly need the Telegram section + DATABASE_URL + AlfaClub auth
#     (so the rich 1659 context can load).
#
# - After updating variables, always trigger a redeploy.
#
# - After redeploy, search logs for:
#     [hermit][early]          ← for the Hermit service
#     [1659-risk-watcher]      ← for the watcher (after we add the diagnostic)
#
# Success = you see a clean "SUMMARY" or "env present" line instead of silent death.
# =============================================================================

# End of 1659 Theatrical Marketing Stack env template
