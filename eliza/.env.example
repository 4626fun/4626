# Required
XMTP_AGENT_PRIVATE_KEY=0x...        # Hex private key for the XMTP agent identity
DATABASE_URL=postgresql://...        # Supabase/Postgres connection string

# XMTP
XMTP_ENV=production                  # production | dev | local

# LLM Provider (pick one — first match wins, priority order below)
GROQ_API_KEY=                        # Groq (fastest, free tier)
OPENAI_API_KEY=                      # OpenAI
ANTHROPIC_API_KEY=                   # Anthropic Claude
OPENROUTER_API_KEY=                  # OpenRouter (multi-model)
