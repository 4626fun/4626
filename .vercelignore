# Repo-root `.vercelignore` for Vercel CLI deployments.
#
# The Vercel project uses Root Directory = `frontend/`, but `vercel deploy`
# from the repo root will still scan the whole repo unless we ignore
# dependency/build artifacts and local secrets/caches here.

# Dependencies (never upload)
node_modules
**/node_modules

# Build artifacts / caches
out
**/out
dist
**/dist
build
**/build
coverage
**/coverage
cache
**/cache
broadcast
**/broadcast
target
**/target
.vite
**/.vite
.turbo
**/.turbo
.tmp
**/.tmp
.temp
**/.temp
*.tsbuildinfo

# Keep API tx-builder handlers (directory name is "build")
!frontend/api/_handlers/v1/build
!frontend/api/_handlers/v1/build/**

# Keep vendored Three.js build (immersive landing imports three.module.js
# from this directory; "build" is the upstream npm package layout)
!frontend/public/immersive/vendor/three/build
!frontend/public/immersive/vendor/three/build/**

# Local env / secrets
.env
.env.*
.env.local
.env*.local

# Tooling / editor state
.git
.github
.cursor
.vercel
.playwright-mcp
.worktrees
.anchor

# Local agent/runtime state
.xmtp-data
**/.xmtp-data

# Archived design media moved out of frontend/public to avoid shipping it.
/design/base-brand-archive
/design/public-asset-archive

# This project deploys from `frontend/`. Exclude unrelated monorepo workspaces
# and source trees when the Vercel CLI is pointed at the repo root.
/apps/*
!/apps/docs-site
!/apps/docs-site/**
/contracts
/kpr
/design
/deployments
/docs
/lib
/out
/output
/programs
/script
/scripts
/target
/test
/tests
/test-ledger
/tmp
/tools

# Local/generated project state outside the frontend deploy surface.
/agent-logs
/broadcast
/cache
