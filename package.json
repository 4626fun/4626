{
  "version": "1.8.1",
  "scripts": {
    "agent:verify-change": "node script/agent-runtime/verify-change.js",
    "check:no-todo-markers": "bash frontend/scripts/check-no-todo-markers.sh",
    "docs:check-links": "node apps/docs-site/scripts/check-doc-links.mjs",
    "docs:check-coverage": "node apps/docs-site/scripts/check-docs-source-coverage.mjs",
    "docs:check-hygiene-policy": "node apps/docs-site/scripts/check-docs-hygiene-policy.mjs",
    "docs:audit-hygiene": "node apps/docs-site/scripts/audit-docs-hygiene.mjs",
    "docs:audit-hygiene:json": "node apps/docs-site/scripts/audit-docs-hygiene.mjs --json",
    "docs:audit-hygiene:strict-stale": "node apps/docs-site/scripts/audit-docs-hygiene.mjs --strict-stale",
    "security:local": "bash scripts/security-audit-local.sh",
    "docs:guard-source-link-pin": "node scripts/check-docs-source-link-pin.mjs",
    "docs:test-release-ref": "node apps/docs-site/scripts/__tests__/source-link-ref-e2e.test.mjs",
    "docs:refresh": "node scripts/check-docs-source-link-pin.mjs && node apps/docs-site/scripts/docs-refresh.mjs",
    "docs:check": "node scripts/check-docs-source-link-pin.mjs && node apps/docs-site/scripts/docs-refresh.mjs --check",
    "docs:build:strict": "pnpm docs:check",
    "docs:bundle": "NODE_OPTIONS=--max-old-space-size=4096 pnpm -C apps/docs-site bundle:strict",
    "docs:drift": "node apps/docs-site/scripts/check-docs-drift.mjs",
    "build:vanity-wasm": "rustup target add wasm32-unknown-unknown && cargo build --manifest-path tools/vanity-salt-grinder/Cargo.toml --release --target wasm32-unknown-unknown && mkdir -p frontend/src/lib/vanity && cp tools/vanity-salt-grinder/target/wasm32-unknown-unknown/release/vanity_salt_grinder.wasm frontend/src/lib/vanity/vanity_salt_grinder.wasm",
    "prepare": "husky || true",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && pnpm eslint --max-warnings 0 --no-warn-ignored'"
    ],
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,sol,toml}": [
      "bash scripts/lint-staged-gitleaks.sh"
    ]
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.159",
