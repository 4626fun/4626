# 4626 Solana keeper orchestrator — production env
# Path on Vultr: /etc/4626/solana-keeper-orchestrator.env
#
# Generate from kpr/.env (recommended):
#   sudo bash kpr/deploy/seed-solana-orchestrator-env.sh \
#     --source /opt/4626/kpr/.env \
#     --dest /etc/4626/solana-keeper-orchestrator.env
#
# Do NOT copy the full kpr/.env here — use orchestrator-only keys (see seed-solana-orchestrator-env.sh).
# Privy, XMTP, and other workflows this service does not need.

# ---------------------------------------------------------------------------
# Orchestrator HTTP (/healthz, POST /reconcile)
# ---------------------------------------------------------------------------
SOLANA_ORCHESTRATOR_PORT=8789
SOLANA_ORCHESTRATOR_API_KEY=replace-with-long-random-secret
SOLANA_ORCHESTRATOR_EXECUTE=1

# M2-09 — single trigger plane. Canonical production path is Vercel cron →
# enqueue → this sidecar POST /reconcile. Leave local KPR workflow cron OFF
# (default). Only set =1 if this host is the sole executor and Vercel reconcile
# is disabled.
# SOLANA_ORCHESTRATOR_LOCAL_CRON_ENABLED=0
# Action-level file lease (default on) blocks dual-plane double-exec:
# SOLANA_ORCHESTRATOR_ACTION_LEASE=1
# SOLANA_ORCHESTRATOR_LEASE_DIR=/var/lib/4626/solana-orchestrator-leases
# SOLANA_ORCHESTRATOR_LEASE_TTL_MS=55000

# Optional per-action gates. Explicit =0 fail-closes even when SOLANA_ORCHESTRATOR_EXECUTE=1.
# Mainnet program uses the canonical settle_fees schema.
SOLANA_HOOK_IX_SCHEMA=canonical
SOLANA_ORCHESTRATOR_SETTLE_FEES_ENABLED=1

# B2 lottery workers are independent, default-off gates. Do not set either to
# 1 until the B2 runbook gate immediately preceding it has passed.
SOLANA_ORCHESTRATOR_LOTTERY_INGEST_ENABLED=0
SOLANA_ORCHESTRATOR_LOTTERY_SUBMIT_ENABLED=0
SOLANA_B2_CANARY_AUTHORIZATION_ENABLED=0
SOLANA_ORCHESTRATOR_LOTTERY_CONFIRM_ENABLED=0
SOLANA_ORCHESTRATOR_LOTTERY_WINNER_SETTLE_ENABLED=0
SOLANA_LOTTERY_INGEST_ENABLED=0
SOLANA_LOTTERY_CONFIRM_ENABLED=0
SOLANA_LOTTERY_WINNER_WORKER_ENABLED=0
SOLANA_ORCHESTRATOR_RELAY_ENTRIES_ENABLED=0
SOLANA_LOTTERY_LZ_TRANSPORT_READY=0
# Bounded timeout for the machine-authenticated OApp sender HTTP hop.
SOLANA_LOTTERY_OAPP_SEND_TIMEOUT_MS=30000

# DLMM jackpot fee claim + Solana→Base fee forward (independent of EXECUTE=1).
# Claim only after protocol LP feeOwner = jackpot authority. Forward also needs
# SOLANA_OFT_FORWARD_HELPER until in-repo LZ Solana OFT send is packaged.
SOLANA_ORCHESTRATOR_CLAIM_DLMM_FEES_ENABLED=0
SOLANA_ORCHESTRATOR_FORWARD_DLMM_FEES_ENABLED=0
# SOLANA_DLMM_FEE_OWNER=
# SOLANA_METEORA_POOL=
# SOLANA_OFT_FORWARD_ENABLED=0
# SOLANA_OFT_STORE=
# SOLANA_OFT_FORWARD_HELPER=
# SOLANA_OFT_FORWARD_TO_BYTES32=   # bytes32(hubGaugeReceiver); or set KPR_REMOTE_FEE_HUB_GAUGE
# KPR_REMOTE_FEE_HUB_GAUGE=

# ---------------------------------------------------------------------------
# RPC — production: copy paid endpoints from kpr/.env (seed script does this)
# ---------------------------------------------------------------------------
# Base: use the same paid BASE_RPC_URL as kpr/.env (e.g. matrixed.link).
# Public https://mainnet.base.org is OK for one-off local preflight only;
# the orchestrator reconcile loop should not rely on it (rate limits under cron).
BASE_RPC_URL=https://eu.endpoints.matrixed.link/rpc/base?auth=YOUR_KEY
# Optional WebSocket pair (same provider as above). Not consumed by
# solana-keeper-orchestrator today — keeper jobs use HTTP only. Other KPR
# workflows (e.g. strategy-signal-listener Swap subscriptions) need it.
# BASE_WS_RPC_URL=wss://eu.endpoints.matrixed.link/ws/base?auth=YOUR_KEY

# Solana: prefer a paid RPC — public mainnet-beta blocks Token-2022 getProgramAccounts
# (breaks settle-fees scans). Copy SOLANA_RPC_URL from kpr/.env when available.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------------------
# Solana program + keeper identity
# ---------------------------------------------------------------------------
SOLANA_PROGRAM_ID=EjpziSWGRcEiDHLXft5etbUtcJiZxEttkwz1tqiuzzWU
SOLANA_KEEPER_KEYPAIR=
SOLANA_KEEPER_PUBKEY=

# ---------------------------------------------------------------------------
# Creator mappings (quote-wrap JSON values)
# ---------------------------------------------------------------------------
SOLANA_CREATOR_MINTS=
SOLANA_SHARE_OFT_MAPPING='{}'
SOLANA_ORCHESTRATOR_ENV_FILE_PATH=/etc/4626/solana-keeper-orchestrator.env
# SOLANA_FEE_ACCOUNTS=
