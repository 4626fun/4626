# Solana keeper orchestrator — pair with Vercel SOLANA_ORCHESTRATOR_* env vars.
# Copy keeper secrets from kpr/.env (SOLANA_KEEPER_KEYPAIR, mappings, RPC URLs).

SOLANA_ORCHESTRATOR_PORT=8789
SOLANA_ORCHESTRATOR_API_KEY=replace-with-long-random-secret

# Enable globally or per action (fail-closed when unset).
SOLANA_ORCHESTRATOR_EXECUTE=1
# SOLANA_ORCHESTRATOR_RELAY_ENTRIES_ENABLED=1
# SOLANA_ORCHESTRATOR_SETTLE_FEES_ENABLED=1
# SOLANA_ORCHESTRATOR_WINNER_RELAY_ENABLED=1
# SOLANA_ORCHESTRATOR_PRICE_MONITOR_ENABLED=1
# SOLANA_ORCHESTRATOR_GRADUATION_ENABLED=1
# SOLANA_ORCHESTRATOR_REBALANCE_ENABLED=1

BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PROGRAM_ID=EjpziSWGRcEiDHLXft5etbUtcJiZxEttkwz1tqiuzzWU

# Required for live keeper actions — see kpr/secrets.example.env
SOLANA_KEEPER_KEYPAIR=
SOLANA_KEEPER_PUBKEY=
SOLANA_CREATOR_MINTS=
SOLANA_SHARE_OFT_MAPPING={}
SOLANA_CREATOR_COIN_TO_MINT_MAPPING={}
SOLANA_TWIN_TO_PUBKEY_MAPPING={}
SOLANA_BRIDGE_ADAPTER=
LOTTERY_MANAGER=
