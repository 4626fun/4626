## Local KPR workflow simulation (example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# Removed: CRE_ETH_PRIVATE_KEY, CRE_RUNTIME_* — use KPR_ETH_PRIVATE_KEY and KPR_* secrets only.
# HTTP keeper paths: /api/keeper/* and /api/keepr/actions/* (not /api/cre/*).
#
# This file maps to `secrets.yaml` names and supports:
# - `pnpm -C kpr run start -- ...`
# - deployment-ready staging/production targets once Early Access is enabled

# Wallet used by KPR CLI account/owner operations.
KPR_ETH_PRIVATE_KEY=YOUR_PRIVATE_KEY_HEX_WITHOUT_0x

# Secrets mapped in `secrets.yaml`.
KPR_API_KEY_VALUE=replace-with-keepr-api-key
KPR_API_BASE_URL_VALUE=https://4626.fun/api
KPR_PRIVATE_KEY_VALUE=YOUR_KEEPER_PRIVATE_KEY_HEX_WITHOUT_0x

# H-09 (4626-301): long-lived AWS keys were removed. Provide a fresh
# OIDC ID token (JWT) that AWS STS can exchange for short-lived S3
# credentials via AssumeRoleWithWebIdentity. Rotation and issuance are
# handled out-of-band — see docs/operations/automation/runtime-api.md (retired archive).
# Leave empty for local-simulation (kvDisabled=true).
AWS_OIDC_TOKEN_VALUE=
# Optional AI provider keys for the KPR -> API AI assessment path.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ELIZA_LLM_PROVIDER_PRIORITY=Groq,OpenAI,Anthropic,OpenRouter

