{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "pnpm dev"
    },
    {
      "name": "Frontend: Chrome (localhost:5173)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "skipFiles": [
        "${workspaceFolder}/frontend/node_modules/**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "Vitest: Current File",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "pnpm exec vitest run \"${file}\""
    }
  ],
  "compounds": [
    {
      "name": "Frontend: Dev + Chrome",
      "configurations": [
        "Frontend: Dev Server",
        "Frontend: Chrome (localhost:5173)"
      ],
      "stopAll": true
    }
  ]
}