{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "pnpm dev"
    },
    {
      "name": "Frontend: Dev + Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: vite dev (background)",
      "sourceMaps": true,
      "skipFiles": [
        "${workspaceFolder}/frontend/node_modules/**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frontend: Chrome only (Vite already running)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "skipFiles": [
        "${workspaceFolder}/frontend/node_modules/**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frontend: Dev + Chrome (WSL → Windows Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: vite dev (background)",
      "runtimeExecutable": "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe",
      "sourceMaps": true,
      "skipFiles": [
        "${workspaceFolder}/frontend/node_modules/**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "Frontend: Chrome only (WSL → Windows Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "runtimeExecutable": "/mnt/c/Program Files/Google/Chrome/Application/chrome.exe",
      "sourceMaps": true,
      "skipFiles": [
        "${workspaceFolder}/frontend/node_modules/**",
        "<node_internals>/**"
      ]
    },
    {
      "name": "Vitest: Current File",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "pnpm exec vitest run \"${file}\""
    }
  ]
}
