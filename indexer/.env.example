# Base mainnet RPC. A paid endpoint (Alchemy, QuickNode, matrixed.link,
# Ankr) is strongly recommended — the public https://mainnet.base.org
# enforces a 10,000-block cap per eth_getLogs request which makes even a
# POC tedious. Paid endpoints typically allow 50k-100k-block queries.
BASE_RPC_URL=https://mainnet.base.org

# Supabase project credentials. The service-role key is required because
# the indexer performs inserts/updates; anon key is insufficient. Use a
# dedicated service-role secret scoped to this indexer if you can.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_JWT>

# Optional: pin the starting block for historical scans. If unset the POC
# script walks backwards from `latest` until it finds enough events. A
# full historical scan should start from the ZoraAccountManager
# deployment block (findable via basescan).
# INDEXER_START_BLOCK=20000000

# Optional: override the target POC row count (default 100).
# POC_TARGET_COUNT=100

# Optional: per-request eth_getLogs block window. Tune to your RPC limit.
# GETLOGS_WINDOW=10000
