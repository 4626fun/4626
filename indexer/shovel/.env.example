# Tier A — Shovel protocol indexer → Supabase Postgres
#
# cp .env.example .env && fill values, then:
#   node render-config.mjs --write
#   docker compose up -d
#
# RPC: reuse the same Alchemy endpoint as Vercel crons/keepers.
# Set BASE_LOGS_RPC_URL in Vercel + here (not BASE_RPC_URL alone for heavy getLogs).

# Direct Postgres URL (Supabase → Project Settings → Database → Connection string → URI).
# Prefer the direct :5432 session URL for long-running Shovel, not the transaction pooler.
SHOVEL_PG_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Alchemy Base mainnet (eth_getLogs). Same value as Vercel BASE_LOGS_RPC_URL.
BASE_LOGS_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Fallback if BASE_LOGS_RPC_URL unset (not recommended for backfill).
# BASE_RPC_URL=

# v1.18.0-greenfield infra (defaults match docs/reference/addresses.md)
DEPLOYMENT_BATCHER=0x02D7abC547F8B1e7E2D7a919D8D1005918361750
LOTTERY_MANAGER=0xbE87AD917bE7f6a9AE1F9c9dd0A7Ec7550F3F8C1

# First block to index. Set to DeploymentBatcher creation block on BaseScan after greenfield cutover.
# Leave 0 to scan from genesis (slow); for v1.18.0 backfill pin the batcher deploy block.
SHOVEL_BASE_START_BLOCK=0

# Shovel tuning (Alchemy typically allows 2k–10k block windows per getLogs)
SHOVEL_BATCH_SIZE=2000
SHOVEL_CONCURRENCY=4
