{
  "name": "@4626/zora-csw-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Indexes Zora-created Coinbase Smart Wallets on Base into Supabase by subscribing to the ZoraAccountManager's ZoraSmartWalletCreated event, then enriches each row with current on-chain owners via ownerAtIndex. The primary asset this service produces is a queryable (csw_address -> owner_eoas[]) table used for pre-qualified outreach and install-flow routing.",
  "type": "module",
  "scripts": {
    "poc": "tsx src/runPoc.ts",
    "index:full": "tsx src/runFull.ts",
    "enrich": "tsx src/runEnrich.ts",
    "classify": "tsx src/classifyOwners.ts",
    "farcaster": "tsx src/crossReferenceFarcaster.ts",
    "names": "tsx src/enrichNames.ts",
    "zora-profiles": "tsx src/enrichZoraProfiles.ts",
    "scan-top-coins": "tsx src/scanTopCoins.ts",
    "enrich-profiles": "tsx src/enrichProfiles.ts",
    "fix-profile-metadata": "tsx src/fixProfileMetadata.ts",
    "polish-profiles": "tsx src/polishProfiles.ts",
    "install-plan": "tsx src/computeInstallPlan.ts",
    "classify-profile-wallets": "tsx src/classifyProfileWallets.ts",
    "scan-coin-holders": "tsx src/scanCoinHolders.ts",
    "flag-holder-contracts": "tsx src/flagHolderContracts.ts",
    "probe:xmtp": "tsx src/probeXmtpReachability.ts",
    "build:master-sheet": "tsx src/buildMasterSheet.ts",
    "build:dm-campaign": "tsx src/buildDmCampaign.ts",
    "groups:plan": "tsx src/createXmtpGroups.ts",
    "groups:plan:priority": "tsx src/createXmtpGroups.ts --shape=priority",
    "groups:plan:top-only": "tsx src/createXmtpGroups.ts --shape=top-only",
    "cluster:cohorts": "tsx src/clusterCohorts.ts",
    "export:outreach": "tsx src/exportOutreach.ts",
    "export:multi-holders": "tsx src/exportMultiHolders.ts",
    "export:top-creators": "tsx src/exportTopCreators.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@xmtp/node-sdk": "5.2.0",
    "@zoralabs/coins-sdk": "^0.3.3",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "brace-expansion": "5.0.6",
      "minimatch": "10.2.3",
      "ws": "8.21.0"
    }
  }
}
